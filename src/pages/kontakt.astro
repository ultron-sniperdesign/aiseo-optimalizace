---
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  meta,
  breadcrumb,
  orgJsonLd,
  hero,
  services,
  trust,
  paths,
  faq,
  direct,
} from "~/content/pages/contact";
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  jsonLd={orgJsonLd}
  image={meta.ogImage}
  breadcrumb={[breadcrumb]}
>
  <div class="kontakt">
    <!-- ===== HERO — agency brand identity ===== -->
    <section class="kontakt-hero" aria-labelledby="kontakt-hero-title">
      <div class="kontakt-hero__inner">
        <a
          href={hero.brandHref}
          target="_blank"
          rel="noopener"
          class="kontakt-hero__brand"
          aria-label={hero.brandAriaLabel}
        >
          <img
            src="/sniperdesign/logo-wh.svg"
            alt={hero.logoAlt}
            width="200"
            height="40"
            loading="eager"
          />
        </a>

        <span class="kontakt-hero__eyebrow">{hero.eyebrow}</span>

        <h1 id="kontakt-hero-title" class="kontakt-hero__title" set:html={hero.titleHtml}></h1>

        <p class="kontakt-hero__lead" set:html={hero.leadHtml}></p>

        <ul class="kontakt-hero__trust" role="list">
          {hero.trust.map((t) => (
            <li>
              <strong set:html={t.strongHtml}></strong>
              <span set:html={t.subHtml}></span>
            </li>
          ))}
        </ul>

        <div class="kontakt-hero__actions">
          <a href={hero.ctaPrimary.href} class="kontakt-btn kontakt-btn--solid">
            <Fragment set:html={hero.ctaPrimary.labelHtml} />
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            href={hero.ctaSecondary.href}
            target="_blank"
            rel="noopener"
            class="kontakt-btn kontakt-btn--ghost"
          >
            {hero.ctaSecondary.label}
          </a>
        </div>

        <p class="kontakt-hero__legal" set:html={hero.legalHtml}></p>
      </div>
    </section>

    <!-- ===== 01 CO DĚLÁME ===== -->
    <section class="lp-section">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{services.eyebrowNum}</span> <Fragment set:html={services.eyebrowHtml} /></span>
        <h2 class="lp-section__title" set:html={services.titleHtml}></h2>
        <p class="lp-section__lead" set:html={services.leadHtml}></p>
      </header>

      <div class="kontakt-services">
        {services.cards.map((c) => (
          <a href={c.href} target="_blank" rel="noopener" class="kontakt-service">
            <span class="kontakt-service__num">{c.num}</span>
            <h3 set:html={c.titleHtml}></h3>
            <p set:html={c.descHtml}></p>
            <span class="kontakt-service__meta" set:html={c.metaHtml}></span>
          </a>
        ))}
      </div>

      <div class="kontakt-bridge">
        <p set:html={services.bridge.textHtml}></p>
        <a href={services.bridge.ctaHref} class="kontakt-bridge__cta">
          {services.bridge.ctaLabel}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </section>

    <!-- ===== 02 PROČ NÁM MŮŽETE DŮVĚŘOVAT ===== -->
    <section class="lp-section lp-section--alt">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{trust.eyebrowNum}</span> <Fragment set:html={trust.eyebrowHtml} /></span>
        <h2 class="lp-section__title" set:html={trust.titleHtml}></h2>
      </header>

      <div class="kontakt-trust">
        {trust.items.map((t) => (
          <article class="kontakt-trust__item">
            <h3 set:html={t.titleHtml}></h3>
            <p set:html={t.descHtml}></p>
          </article>
        ))}
      </div>
    </section>

    <!-- ===== 03 JAK SE NÁM OZVAT ===== -->
    <section class="lp-section">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{paths.eyebrowNum}</span> <Fragment set:html={paths.eyebrowHtml} /></span>
        <h2 class="lp-section__title" set:html={paths.titleHtml}></h2>
      </header>

      <div class="kontakt-paths">
        {paths.cards.map((c) => (
          <article class:list={["kontakt-path", c.variant && `kontakt-path--${c.variant}`]}>
            <span
              class:list={["kontakt-path__pill", c.pillVariant && `kontakt-path__pill--${c.pillVariant}`]}
              set:html={c.pillHtml}
            ></span>
            <h3 set:html={c.titleHtml}></h3>
            <p set:html={c.descHtml}></p>
            <a
              href={c.cta.href}
              target={c.cta.external ? "_blank" : undefined}
              rel={c.cta.external ? "noopener" : undefined}
              class:list={["kontakt-path__cta", c.cta.accent && "kontakt-path__cta--accent"]}
              set:html={c.cta.labelHtml}
            ></a>
            {c.subHtml && <p class="kontakt-path__sub" set:html={c.subHtml}></p>}
          </article>
        ))}
      </div>
    </section>

    <!-- ===== 04 FAQ — scam-prevention pojistka ===== -->
    <section class="lp-section">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{faq.eyebrowNum}</span> <Fragment set:html={faq.eyebrowHtml} /></span>
        <h2 class="lp-section__title" set:html={faq.titleHtml}></h2>
        <p class="lp-section__lead" set:html={faq.leadHtml}></p>
      </header>

      <dl class="kontakt-faq">
        {faq.items.map((f) => (
          <div>
            <dt set:html={f.qHtml}></dt>
            <dd set:html={f.aHtml}></dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- ===== 05 KONTAKTY + FAKTURACE (compact, ne dominantní) ===== -->
    <section class="lp-section lp-section--alt">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{direct.eyebrowNum}</span> <Fragment set:html={direct.eyebrowHtml} /></span>
        <h2 class="lp-section__title" set:html={direct.titleHtml}></h2>
      </header>

      <div class="kontakt-direct">
        <div class="kontakt-direct__col">
          <h3>{direct.contactsHeading}</h3>
          <dl class="kontakt-direct__list">
            {direct.contactRows.map((r) => (
              <div>
                <dt>{r.dt}</dt>
                <dd set:html={r.ddHtml}></dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="kontakt-direct__col">
          <h3>{direct.billingHeading}</h3>
          <dl class="kontakt-direct__list">
            {direct.billingRows.map((r) => (
              <div>
                <dt>{r.dt}</dt>
                <dd set:html={r.ddHtml}></dd>
              </div>
            ))}
          </dl>

          <p class="kontakt-direct__legal" set:html={direct.legalHtml}></p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .kontakt {
    --font-agency: "Kumbh Sans", var(--font-sans);
    --lp-violet: oklch(0.55 0.25 305);
    --lp-magenta: oklch(0.5 0.27 335);
    --sd-deep: oklch(0.22 0.13 305);
    --sd-deeper: oklch(0.16 0.11 305);
    --sd-violet: oklch(0.55 0.25 305);
    --sd-magenta: oklch(0.5 0.27 335);
    --sd-gold: oklch(0.82 0.16 80);
    --sd-paper: oklch(0.985 0.004 250);
  }

  /* ===== HERO — Sniper Design brand box ===== */
  .kontakt-hero {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: clamp(1.5rem, 3vw, 2.5rem) var(--space-section-x) clamp(2rem, 4vw, 3.5rem);
  }
  .kontakt-hero__inner {
    background:
      radial-gradient(ellipse 70% 60% at 110% 0%, color-mix(in oklch, var(--sd-magenta) 30%, transparent), transparent 60%),
      radial-gradient(ellipse 80% 70% at -10% 100%, color-mix(in oklch, var(--sd-violet) 32%, transparent), transparent 60%),
      linear-gradient(135deg, var(--sd-deep) 0%, var(--sd-deeper) 100%);
    color: var(--sd-paper);
    border-radius: 14px;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.75rem, 4vw, 3.5rem);
    position: relative;
    overflow: hidden;
  }
  .kontakt-hero__inner::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--sd-violet) 0%, var(--sd-magenta) 100%);
  }
  .kontakt-hero__brand {
    display: inline-block;
    margin-bottom: clamp(1.25rem, 3vw, 1.75rem);
  }
  .kontakt-hero__brand img {
    width: 200px;
    height: auto;
  }
  .kontakt-hero__eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: oklch(from var(--sd-gold) l c h / 0.85);
    margin-bottom: 0.875rem;
  }
  .kontakt-hero__title {
    font-family: var(--font-agency);
    font-weight: 300;
    font-size: clamp(1.875rem, 4.5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--sd-paper);
    margin: 0 0 1.25rem;
    max-width: 38rem;
  }
  .kontakt-hero__title :global(strong) {
    font-weight: 700;
    color: color-mix(in oklch, var(--sd-magenta) 60%, white);
  }
  .kontakt-hero__lead {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.6;
    color: oklch(from var(--sd-paper) l c h / 0.85);
    margin: 0 0 1.75rem;
    max-width: 38rem;
  }
  .kontakt-hero__lead :global(a) {
    color: color-mix(in oklch, var(--sd-magenta) 60%, white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .kontakt-hero__lead :global(strong) { color: var(--sd-paper); font-weight: 600; }

  /* Trust strip — 4 položky */
  .kontakt-hero__trust {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    padding: 1.5rem 0;
    margin: 0 0 1.75rem;
    border-top: 1px solid oklch(from var(--sd-paper) l c h / 0.15);
    border-bottom: 1px solid oklch(from var(--sd-paper) l c h / 0.15);
  }
  @media (min-width: 640px) {
    .kontakt-hero__trust { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .kontakt-hero__trust { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  }
  .kontakt-hero__trust li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .kontakt-hero__trust strong {
    font-family: var(--font-agency);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--sd-paper);
    letter-spacing: -0.01em;
  }
  .kontakt-hero__trust span {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.4;
    color: oklch(from var(--sd-paper) l c h / 0.7);
  }
  .kontakt-hero__trust :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: oklch(from var(--sd-paper) l c h / 0.3);
  }

  /* Actions — CTA buttons */
  .kontakt-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .kontakt-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.875rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .kontakt-btn--solid {
    background: var(--sd-gold);
    color: var(--sd-deep);
  }
  .kontakt-btn--solid:hover {
    background: color-mix(in oklch, var(--sd-gold) 85%, white);
    transform: translateY(-1px);
  }
  .kontakt-btn--ghost {
    background: transparent;
    color: var(--sd-paper);
    border: 1px solid oklch(from var(--sd-paper) l c h / 0.25);
  }
  .kontakt-btn--ghost:hover {
    background: oklch(from var(--sd-paper) l c h / 0.08);
    border-color: oklch(from var(--sd-paper) l c h / 0.4);
  }

  /* ===== Mini legal line pod hero CTA ===== */
  .kontakt-hero__legal {
    margin: 1.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: oklch(from var(--sd-paper) l c h / 0.55);
  }
  .kontakt-hero__legal :global(strong) {
    color: oklch(from var(--sd-paper) l c h / 0.85);
    font-weight: 700;
  }

  /* ===== Sdílené primitivy z /pack/ ===== */
  .lp-section {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) var(--space-section-x);
  }
  .lp-section--alt {
    background: var(--color-paper-deep);
    max-width: none;
    padding-left: 0;
    padding-right: 0;
  }
  .lp-section--alt > * {
    max-width: var(--max-section);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--space-section-x);
    padding-right: var(--space-section-x);
  }
  .lp-section__head {
    max-width: 50rem;
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
  }
  .lp-section__title {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 1rem;
  }
  .lp-section__title :global(strong) {
    color: var(--lp-violet);
    font-weight: 700;
  }
  .lp-section__lead {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0;
    max-width: 40rem;
  }
  .lp-section__lead :global(strong) { color: var(--color-ink); font-weight: 600; }

  .eyebrow {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: 1rem;
  }
  .eyebrow__num {
    color: var(--lp-violet);
    font-weight: 700;
  }

  /* ===== Services grid (6 services) ===== */
  .kontakt-services {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  @media (min-width: 640px) {
    .kontakt-services { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1080px) {
    .kontakt-services { grid-template-columns: repeat(3, 1fr); }
  }
  .kontakt-service {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    padding: 1.5rem 1.375rem 1.25rem;
    text-decoration: none;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .kontakt-service:hover {
    border-color: var(--lp-violet);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -10px oklch(from var(--lp-violet) l c h / 0.25);
  }
  .kontakt-service__num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--lp-violet);
    letter-spacing: 0.08em;
  }
  .kontakt-service h3 {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin: 0;
  }
  .kontakt-service p {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
    margin: 0;
    flex: 1;
  }
  .kontakt-service__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
    letter-spacing: 0.02em;
    padding-top: 0.625rem;
    margin-top: 0.25rem;
    border-top: 1px dashed var(--color-rule);
  }

  /* ===== Bridge to Pack (po sekci 01) ===== */
  .kontakt-bridge {
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    padding: 1.25rem 1.5rem;
    background: oklch(0.96 0.05 305 / 0.5);
    border: 1px solid oklch(from var(--lp-violet) l c h / 0.2);
    border-left: 3px solid var(--lp-violet);
    border-radius: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }
  .kontakt-bridge p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-ink);
    flex: 1 1 24rem;
  }
  .kontakt-bridge p :global(strong) { font-weight: 600; }
  .kontakt-bridge__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
    background: var(--lp-violet);
    padding: 0.625rem 1.125rem;
    border-radius: 999px;
    text-decoration: none;
    flex-shrink: 0;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .kontakt-bridge__cta:hover {
    background: color-mix(in oklch, var(--lp-violet) 85%, black);
    transform: translateY(-1px);
  }

  /* ===== Trust block (4 proof points) ===== */
  .kontakt-trust {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  @media (min-width: 768px) {
    .kontakt-trust { grid-template-columns: repeat(2, 1fr); }
  }
  .kontakt-trust__item {
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-left: 3px solid var(--lp-violet);
    border-radius: 10px;
    padding: 1.5rem 1.5rem 1.375rem;
  }
  .kontakt-trust__item h3 {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
    margin: 0 0 0.625rem;
  }
  .kontakt-trust__item p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0;
  }
  .kontakt-trust__item p :global(a) {
    color: var(--lp-violet);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .kontakt-trust__item p :global(strong) { color: var(--color-ink); }

  /* ===== Kontakt paths (3 cards) — sdíleno s předchozí verzí ===== */
  .kontakt-paths {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  @media (min-width: 768px) {
    .kontakt-paths { grid-template-columns: repeat(3, 1fr); }
  }
  .kontakt-path {
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    padding: 1.5rem 1.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .kontakt-path--accent {
    border-color: var(--lp-magenta);
    background: oklch(0.97 0.04 335 / 0.4);
  }
  .kontakt-path--featured {
    border-color: var(--lp-violet);
    border-width: 2px;
    background: oklch(0.97 0.04 305 / 0.4);
    box-shadow: 0 8px 22px -10px oklch(from var(--lp-violet) l c h / 0.3);
  }
  .kontakt-path__sub {
    font-size: 0.8125rem !important;
    line-height: 1.5 !important;
    color: var(--color-ink-faint) !important;
    margin: 0.25rem 0 0 !important;
    flex: none !important;
  }
  .kontakt-path__sub :global(a) {
    color: var(--color-ink-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .kontakt-path__pill {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    background: var(--color-paper-deep);
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
  }
  .kontakt-path__pill--pack {
    color: var(--lp-violet);
    background: oklch(0.96 0.05 305 / 0.6);
  }
  .kontakt-path__pill--audit {
    color: #fff;
    background: var(--lp-magenta);
  }
  .kontakt-path h3 {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin: 0;
  }
  .kontakt-path h3 :global(a) {
    color: inherit;
    text-decoration: underline;
