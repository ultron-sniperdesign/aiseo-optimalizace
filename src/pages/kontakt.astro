---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Faq from "~/components/blocks/Faq.astro";
import PartnerBadges from "~/components/blocks/PartnerBadges.astro";
import SniperMark from "~/components/sniperdesign/SniperMark.astro";
import {
  meta,
  breadcrumb,
  orgJsonLd,
  contactPageJsonLd,
  hero,
  about,
  services,
  trust,
  meeting,
  faq,
  direct,
} from "~/content/pages/contact";
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  jsonLd={[orgJsonLd, contactPageJsonLd]}
  image={meta.ogImage}
  breadcrumb={[breadcrumb]}
>
  <div class="kontakt">
    <!-- ===== HERO — agency brand identity ===== -->
    <section class="kontakt-hero" aria-labelledby="kontakt-hero-title">
      <div class="kontakt-hero__inner">
        <div class="kontakt-hero__top">
          <a
            href={hero.brandHref}
            target="_blank"
            rel="noopener"
            class="kontakt-hero__brand"
            aria-label={hero.brandAriaLabel}
          >
            <img
              src="/sniperdesign/logo-wh.svg"
              alt={hero.logoAlt}
              width="200"
              height="40"
              loading="eager"
            />
          </a>

          <div class="kontakt-hero__partners">
            <PartnerBadges />
          </div>
        </div>

        <h1 id="kontakt-hero-title" class="kontakt-hero__title" set:html={hero.titleHtml}></h1>

        <p class="kontakt-hero__lead" set:html={hero.leadHtml}></p>

        <ul class="kontakt-hero__contacts" role="list">
          {hero.contacts.map((c) => (
            <li class="kontakt-contact">
              <span class="kontakt-contact__label">{c.label}</span>
              <a href={c.href} class="kontakt-contact__value" set:html={c.valueHtml}></a>
              <span class="kontakt-contact__note">{c.note}</span>
            </li>
          ))}
        </ul>

        <ul class="kontakt-hero__trust" role="list">
          {hero.trust.map((t) => (
            <li>
              <strong set:html={t.strongHtml}></strong>
              <span set:html={t.subHtml}></span>
            </li>
          ))}
        </ul>

        <p class="kontakt-hero__legal" set:html={hero.legalHtml}></p>
      </div>
    </section>

    <!-- ===== 01 ONLINE SCHŮZKA — jediná cesta, kterou na kontaktu nabízíme ===== -->
    <section class="lp-section" aria-labelledby="kontakt-meeting-title">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{meeting.eyebrowNum}</span> <Fragment set:html={meeting.eyebrowHtml} /></span>
        <h2 id="kontakt-meeting-title" class="lp-section__title" set:html={meeting.titleHtml}></h2>
      </header>

      <div class="kontakt-meeting">
        <div class="kontakt-meeting__body">
          <p class="kontakt-meeting__lead" set:html={meeting.leadHtml}></p>
          <ul class="kontakt-meeting__facts" role="list">
            {meeting.facts.map((f) => <li set:html={f}></li>)}
          </ul>
        </div>
        <div class="kontakt-meeting__action">
          <a
            href={meeting.cta.href}
            target="_blank"
            rel="noopener"
            class="kontakt-meeting__cta"
            set:html={meeting.cta.labelHtml}
          ></a>
          <p class="kontakt-meeting__note" set:html={meeting.cta.noteHtml}></p>
        </div>
      </div>
    </section>

    <!-- ===== 02 KDO JSME — medailonek v barvách značky (od 14. 10. 2026) =====
         Vizuální jazyk z podkladů agentury (bannery, znak): fialové pozadí,
         nadpis bílá + zlatá, znak S ve zlatém šestiúhelníku, obrysy šestiúhelníků. -->
    <section class="lp-section lp-section--alt" aria-labelledby="kontakt-about-title">
      <!-- Rám je přímý potomek alt sekce (ta mu dá šířku a okraj), karta až uvnitř. -->
      <div class="kontakt-medal-frame">
      <div class="kontakt-medal">
        <div class="kontakt-medal__deco kontakt-medal__deco--tr"><svg viewBox="0 0 100 116" aria-hidden="true" focusable="false"><polygon points="50,2 98,30 98,86 50,114 2,86 2,30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" vector-effect="non-scaling-stroke"></polygon></svg></div>
        <div class="kontakt-medal__deco kontakt-medal__deco--bl"><svg viewBox="0 0 100 116" aria-hidden="true" focusable="false"><polygon points="50,2 98,30 98,86 50,114 2,86 2,30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" vector-effect="non-scaling-stroke"></polygon></svg></div>

        <div class="kontakt-medal__emblem">
          <SniperMark />
        </div>

        <div class="kontakt-medal__body">
          <span class="eyebrow"><span class="eyebrow__num">{about.eyebrowNum}</span> <Fragment set:html={about.eyebrowHtml} /></span>
          <h2 id="kontakt-about-title" class="kontakt-medal__title" set:html={about.titleHtml}></h2>
          {about.paragraphsHtml.map((p, i) => (
            <p class:list={["kontakt-medal__p", i === 0 && "kontakt-medal__p--lead"]} set:html={p}></p>
          ))}
          <a
            href={about.more.href}
            target="_blank"
            rel="noopener"
            class="kontakt-medal__more"
            set:html={about.more.labelHtml}
          ></a>
        </div>
      </div>
      </div>
    </section>

    <!-- ===== 03 CO DĚLÁME ===== -->
    <section class="lp-section">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{services.eyebrowNum}</span> <Fragment set:html={services.eyebrowHtml} /></span>
        <h2 class="lp-section__title" set:html={services.titleHtml}></h2>
        <p class="lp-section__lead" set:html={services.leadHtml}></p>
      </header>

      <div class="kontakt-services">
        {services.cards.map((c) => (
          <a
            href={c.href}
            target={c.external ? "_blank" : undefined}
            rel={c.external ? "noopener" : undefined}
            class="kontakt-service"
          >
            <span class="kontakt-service__num">{c.num}</span>
            <h3 set:html={c.titleHtml}></h3>
            <p set:html={c.descHtml}></p>
            <span class="kontakt-service__meta" set:html={c.metaHtml}></span>
          </a>
        ))}
      </div>

    </section>

    <!-- ===== 04 PROČ NÁM MŮŽETE DŮVĚŘOVAT ===== -->
    <section class="lp-section lp-section--alt">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{trust.eyebrowNum}</span> <Fragment set:html={trust.eyebrowHtml} /></span>
        <h2 class="lp-section__title" set:html={trust.titleHtml}></h2>
      </header>

      <div class="kontakt-trust">
        {trust.items.map((t) => (
          <article class="kontakt-trust__item">
            <h3 set:html={t.titleHtml}></h3>
            <p set:html={t.descHtml}></p>
          </article>
        ))}
      </div>
    </section>

    <!-- ===== 05 ČASTÉ OTÁZKY ===== -->
    <section class="lp-section lp-section--faq">
      <Faq
        items={faq.items}
        eyebrowNum={faq.eyebrowNum}
        eyebrow={faq.eyebrow}
        titleHtml={faq.titleHtml}
        leadHtml={faq.leadHtml}
      />
    </section>

    <!-- ===== 06 FAKTURAČNÍ ÚDAJE A SÍDLO ===== -->
    <section class="lp-section">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{direct.eyebrowNum}</span> <Fragment set:html={direct.eyebrowHtml} /></span>
        <h2 class="lp-section__title" set:html={direct.titleHtml}></h2>
      </header>

      <div class="kontakt-direct">
        <div class="kontakt-direct__col">
          <h3>{direct.contactsHeading}</h3>
          <dl class="kontakt-direct__list">
            {direct.contactRows.map((r) => (
              <div>
                <dt>{r.dt}</dt>
                <dd set:html={r.ddHtml}></dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="kontakt-direct__col">
          <h3>{direct.billingHeading}</h3>
          <dl class="kontakt-direct__list">
            {direct.billingRows.map((r) => (
              <div>
                <dt>{r.dt}</dt>
                <dd set:html={r.ddHtml}></dd>
              </div>
            ))}
          </dl>

          <p class="kontakt-direct__legal" set:html={direct.legalHtml}></p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Paleta Sniper Design je globalni (global.css). Tady jen dva aliasy,
     ktere pouzivaji akcentove CTA teto stranky. */
  .kontakt {
    --lp-violet: var(--sd-violet);
    --lp-magenta: var(--sd-magenta);
  }

  /* ===== HERO — Sniper Design brand box ===== */
  .kontakt-hero {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: clamp(1.5rem, 3vw, 2.5rem) var(--space-section-x) clamp(2rem, 4vw, 3.5rem);
  }
  .kontakt-hero__inner {
    background:
      radial-gradient(ellipse 70% 60% at 110% 0%, color-mix(in oklch, var(--sd-magenta) 30%, transparent), transparent 60%),
      radial-gradient(ellipse 80% 70% at -10% 100%, color-mix(in oklch, var(--sd-violet) 32%, transparent), transparent 60%),
      linear-gradient(135deg, var(--sd-deep) 0%, var(--sd-deeper) 100%);
    color: var(--sd-paper);
    border-radius: 14px;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.75rem, 4vw, 3.5rem);
    position: relative;
    overflow: hidden;
  }
  .kontakt-hero__inner::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--sd-violet) 0%, var(--sd-magenta) 100%);
  }
  /* Logo vlevo, odznaky partnerstvi vpravo — prvni radek stranky (od 14. 10. 2026).
     Odznaky tu jsou nejviditelnejsi, a pritom kontaktum neuberou misto pod H1. */
  .kontakt-hero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .kontakt-hero__brand {
    display: inline-block;
  }
  .kontakt-hero__brand img {
    width: 200px;
    height: auto;
  }
  .kontakt-hero__title {
    font-family: var(--font-agency);
    font-weight: 300;
    font-size: clamp(1.875rem, 4.5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--sd-paper);
    margin: 0 0 1.25rem;
    max-width: 38rem;
  }
  .kontakt-hero__title :global(strong) {
    font-weight: 700;
    color: color-mix(in oklch, var(--sd-magenta) 60%, white);
  }
  .kontakt-hero__lead {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.6;
    color: oklch(from var(--sd-paper) l c h / 0.85);
    margin: 0 0 1.75rem;
    max-width: 38rem;
  }
  .kontakt-hero__lead :global(a) {
    color: color-mix(in oklch, var(--sd-magenta) 60%, white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .kontakt-hero__lead :global(strong) { color: var(--sd-paper); font-weight: 600; }

  /* Trust strip — 4 položky */
  .kontakt-hero__trust {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    padding: 1.5rem 0;
    margin: 0 0 1.75rem;
    border-top: 1px solid oklch(from var(--sd-paper) l c h / 0.15);
    border-bottom: 1px solid oklch(from var(--sd-paper) l c h / 0.15);
  }
  @media (min-width: 640px) {
    .kontakt-hero__trust { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .kontakt-hero__trust { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  }
  .kontakt-hero__trust li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .kontakt-hero__trust strong {
    font-family: var(--font-agency);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--sd-paper);
    letter-spacing: -0.01em;
  }
  .kontakt-hero__trust span {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.4;
    color: oklch(from var(--sd-paper) l c h / 0.7);
  }
  .kontakt-hero__trust :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: oklch(from var(--sd-paper) l c h / 0.3);
  }

  /* Actions — CTA buttons */

  /* ===== Kontaktni dlazdice v hero (od 22. 9. 2026) =====
     Telefon, e-mail a formular jsou prvni obsah stranky. Drive tu stala dve
     tlacitka, ktera vedla na Pack a na web agentury — tedy nikam, kde se da
     ozvat. Odkazy jsou v set:html, proto :global() (CLAUDE.md § VI). */
  /* Flex, ne mrizka: dlazdice maji sirku podle obsahu, takze se e-mail na desktopu
     vejde na jeden radek (v pevne mrizce 2 x 358 px se lamal). Na uzkem displeji
     jdou pod sebe na celou sirku. */
  .kontakt-hero__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    margin: 0 0 clamp(1.75rem, 3vw, 2.25rem);
    padding: 0;
    list-style: none;
  }
  .kontakt-contact {
    flex: 1 1 100%;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.125rem;
    border-radius: 10px;
    background: oklch(from var(--sd-paper) l c h / 0.07);
    border: 1px solid oklch(from var(--sd-paper) l c h / 0.14);
  }
  @media (min-width: 640px) {
    .kontakt-contact { flex: 0 1 auto; min-width: 14rem; }
  }
  .kontakt-contact__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: oklch(from var(--sd-gold) l c h / 0.85);
  }
  .kontakt-contact__value {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 600;
    color: var(--sd-paper);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .kontakt-contact__value:hover { text-decoration: underline; text-underline-offset: 3px; }
  .kontakt-contact__note {
    font-size: 0.8rem;
    line-height: 1.4;
    color: oklch(from var(--sd-paper) l c h / 0.72);
  }

  /* Odznaky partnerstvi — komponenta nese vlastni styl, tady jen odsazeni
     a barvy pro tmave pozadi hero. */
  .kontakt-hero__partners {
    /* 14. 10. 2026: odznaky maji byt viditelnejsi — o petinu vetsi a se zlatym
       okrajem misto bileho. Velikost i barvy jdou pres promenne komponenty.
       Na uzkem displeji vychozi velikost: pri 1,2 se odznak Upgates lamal do
       tri radku a odsouval kontakty. */
    --partner-scale: 1;
    /* Barvy odznaku se komponente predavaji PROMENNYMI, ne pres :global().
       22. 9. 2026 tu byl primy zapis `:global(.partner) { color: … }`, ktery
       prebil jen popredi — pozadi zustalo bile z fallbacku komponenty a text
       zmizel bila na bile. Stejne ctyri promenne pouziva /audit/ i oba bloky
       Sniper Design. */
    --partner-fg: var(--sd-paper);
    --partner-muted: color-mix(in oklch, var(--sd-paper) 72%, transparent);
    --partner-border: color-mix(in oklch, var(--sd-gold) 70%, transparent);
    --partner-bg: color-mix(in oklch, var(--sd-gold) 12%, transparent);
  }

  @media (min-width: 640px) {
    .kontakt-hero__partners { --partner-scale: 1.2; }
  }

  /* ===== 02 Kdo jsme — medailonek v barvách značky (od 14. 10. 2026) =====
     Barvy z podkladů agentury: pozadí `--sd-brand` (fialová ze znaku a bannerů)
     tmavnoucí k `--sd-brand-deep`, zvýraznění `--sd-gold`. Text drží --w-read
     na odstavcích (ne na obalu: `.lp-section--alt > *` má vyšší specificitu).
     Obsah v set:html -> :global(). */
  /* Karta nesmí být přímý potomek `.lp-section--alt`: pravidlo `> *` (vyšší
     specificita) jí přepíše vodorovný padding i okraje a karta se roztáhne
     k okrajům okna. Proto rám `.kontakt-medal-frame`.
     `overflow: clip`, ne `hidden`: dekorativní šestiúhelník přesahuje okraj
     a kontejner s `hidden` jde posunout programově (scrollIntoView, hledání na
     stránce, přechod tabulátorem na odkaz) — obsah pak ujede o desítky px. */
  .kontakt-medal {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(2rem, 5vw, 3.75rem) clamp(1.5rem, 5vw, 3.75rem);
    border-radius: 14px;
    color: var(--sd-paper);
    background:
      radial-gradient(ellipse 65% 85% at 22% 35%, var(--sd-brand), transparent 72%),
      radial-gradient(ellipse 55% 70% at 95% 110%, color-mix(in oklch, var(--sd-brand) 70%, transparent), transparent 70%),
      linear-gradient(160deg, var(--sd-brand-deep) 0%, color-mix(in oklch, var(--sd-brand) 45%, var(--sd-brand-deep)) 55%, var(--sd-brand-deep) 100%);
  }
  @media (min-width: 860px) {
    .kontakt-medal { grid-template-columns: auto 1fr; }
  }
  /* Obrysy šestiúhelníků v pozadí — motiv z bannerů agentury. */
  .kontakt-medal__deco {
    position: absolute;
    z-index: -1;
    color: oklch(from var(--sd-paper) l c h / 0.12);
    pointer-events: none;
  }
  .kontakt-medal__deco :global(svg) { display: block; width: 100%; height: auto; }
  .kontakt-medal__deco--tr { width: clamp(12rem, 26vw, 22rem); top: -28%; right: -6%; }
  .kontakt-medal__deco--bl { width: clamp(7rem, 13vw, 11rem); bottom: -22%; left: 34%; }

  .kontakt-medal__emblem {
    width: clamp(5.5rem, 15vw, 11rem);
    /* Na tmavém podkladu bílé S ve zlatém šestiúhelníku — jako avatar agentury. */
    --mark-hex: var(--sd-gold);
    --mark-s: var(--sd-paper);
    filter: drop-shadow(0 10px 24px oklch(from var(--sd-brand-deep) l c h / 0.55));
  }

  .kontakt-medal .eyebrow { color: oklch(from var(--sd-paper) l c h / 0.72); margin-bottom: 0.875rem; }
  .kontakt-medal .eyebrow__num { color: var(--sd-gold); }

  .kontakt-medal__title {
    font-family: var(--font-agency);
    font-weight: 700;
    font-size: clamp(1.625rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--sd-paper);
    margin: 0 0 1.25rem;
    text-wrap: balance;
  }
  /* Nadpis jako na bannerech: bílá + zlatá. `.hl` jinak bere barvu disciplíny. */
  .kontakt-medal__title :global(.hl) { color: var(--sd-paper); font-weight: inherit; }
  .kontakt-medal__title :global(strong) { color: var(--sd-gold); font-weight: 700; }

  .kontakt-medal__p {
    max-width: var(--w-read);
    font-size: 1rem;
    line-height: 1.7;
    color: oklch(from var(--sd-paper) l c h / 0.84);
    margin: 0 0 1rem;
  }
  .kontakt-medal__p--lead {
    font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
    line-height: 1.6;
    color: var(--sd-paper);
  }
  .kontakt-medal__p :global(strong) { color: var(--sd-paper); font-weight: 700; }
  .kontakt-medal__p :global(a) {
    color: var(--sd-gold);
    text-decoration: underline;
    text-decoration-color: oklch(from var(--sd-gold) l c h / 0.55);
    text-underline-offset: 3px;
  }
  .kontakt-medal__p :global(a:hover) { text-decoration-color: var(--sd-gold); }

  /* Zlaté tlačítko jako „na míru“ na bannerech: zlatý přechod, tmavě fialový text. */
  .kontakt-medal__more {
    display: inline-block;
    margin-top: 0.75rem;
    font-family: var(--font-agency);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--sd-brand-deep);
    background: linear-gradient(180deg, var(--sd-gold) 0%, var(--sd-gold-deep) 100%);
    padding: 0.8rem 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    box-shadow: 0 10px 22px -12px oklch(from var(--sd-gold-deep) l c h / 0.8);
    transition: transform 0.15s ease;
  }
  .kontakt-medal__more:hover { transform: translateY(-1px); }
  .kontakt-medal__more:focus-visible { outline: 3px solid var(--sd-paper); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .kontakt-medal__more { transition: none; }
  }

  /* ===== Mini legal line pod hero ===== */
  .kontakt-hero__legal {
    margin: 1.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: oklch(from var(--sd-paper) l c h / 0.55);
  }
  .kontakt-hero__legal :global(strong) {
    color: oklch(from var(--sd-paper) l c h / 0.85);
    font-weight: 700;
  }

  /* ===== Sdílené primitivy z /pack/ ===== */
  .lp-section {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) var(--space-section-x);
  }
  /* Sekce už dává rám i svislý odstup — komponentě FAQ je vypneme,
     jinak by se odsazení sečetlo dvakrát. */
