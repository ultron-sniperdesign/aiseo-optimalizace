---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Faq from "~/components/blocks/Faq.astro";
import PartnerBadges from "~/components/blocks/PartnerBadges.astro";
import {
  meta,
  breadcrumb,
  orgJsonLd,
  contactPageJsonLd,
  hero,
  about,
  services,
  trust,
  meeting,
  faq,
  direct,
} from "~/content/pages/contact";
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  jsonLd={[orgJsonLd, contactPageJsonLd]}
  image={meta.ogImage}
  breadcrumb={[breadcrumb]}
>
  <div class="kontakt">
    <!-- ===== HERO — agency brand identity ===== -->
    <section class="kontakt-hero" aria-labelledby="kontakt-hero-title">
      <div class="kontakt-hero__inner">
        <div class="kontakt-hero__top">
          <a
            href={hero.brandHref}
            target="_blank"
            rel="noopener"
            class="kontakt-hero__brand"
            aria-label={hero.brandAriaLabel}
          >
            <img
              src="/sniperdesign/logo-wh.svg"
              alt={hero.logoAlt}
              width="200"
              height="40"
              loading="eager"
            />
          </a>

          <div class="kontakt-hero__partners">
            <PartnerBadges />
          </div>
        </div>

        <h1 id="kontakt-hero-title" class="kontakt-hero__title" set:html={hero.titleHtml}></h1>

        <p class="kontakt-hero__lead" set:html={hero.leadHtml}></p>

        <ul class="kontakt-hero__contacts" role="list">
          {hero.contacts.map((c) => (
            <li class="kontakt-contact">
              <span class="kontakt-contact__label">{c.label}</span>
              <a href={c.href} class="kontakt-contact__value" set:html={c.valueHtml}></a>
              <span class="kontakt-contact__note">{c.note}</span>
            </li>
          ))}
        </ul>

        <ul class="kontakt-hero__trust" role="list">
          {hero.trust.map((t) => (
            <li>
              <strong set:html={t.strongHtml}></strong>
              <span set:html={t.subHtml}></span>
            </li>
          ))}
        </ul>

        <p class="kontakt-hero__legal" set:html={hero.legalHtml}></p>
      </div>
    </section>

    <!-- ===== 01 ONLINE SCHŮZKA — jediná cesta, kterou na kontaktu nabízíme ===== -->
    <section class="lp-section" aria-labelledby="kontakt-meeting-title">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{meeting.eyebrowNum}</span> <Fragment set:html={meeting.eyebrowHtml} /></span>
        <h2 id="kontakt-meeting-title" class="lp-section__title" set:html={meeting.titleHtml}></h2>
      </header>

      <div class="kontakt-meeting">
        <div class="kontakt-meeting__body">
          <p class="kontakt-meeting__lead" set:html={meeting.leadHtml}></p>
          <ul class="kontakt-meeting__facts" role="list">
            {meeting.facts.map((f) => <li set:html={f}></li>)}
          </ul>
        </div>
        <div class="kontakt-meeting__action">
          <a
            href={meeting.cta.href}
            target="_blank"
            rel="noopener"
            class="kontakt-meeting__cta"
            set:html={meeting.cta.labelHtml}
          ></a>
          <p class="kontakt-meeting__note" set:html={meeting.cta.noteHtml}></p>
        </div>
      </div>
    </section>

    <!-- ===== 02 KDO JSME — medailonek firmy ===== -->
    <section class="lp-section lp-section--alt">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{about.eyebrowNum}</span> <Fragment set:html={about.eyebrowHtml} /></span>
        <h2 class="lp-section__title" set:html={about.titleHtml}></h2>
      </header>

      <div class="kontakt-about">
        {about.paragraphsHtml.map((p, i) => (
          <p class:list={["kontakt-about__p", i === 0 && "kontakt-about__p--lead"]} set:html={p}></p>
        ))}
        <p class="kontakt-about__more">
          <a href={about.more.href} target="_blank" rel="noopener" set:html={about.more.labelHtml}></a>
        </p>
      </div>
    </section>

    <!-- ===== 03 CO DĚLÁME ===== -->
    <section class="lp-section">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{services.eyebrowNum}</span> <Fragment set:html={services.eyebrowHtml} /></span>
        <h2 class="lp-section__title" set:html={services.titleHtml}></h2>
        <p class="lp-section__lead" set:html={services.leadHtml}></p>
      </header>

      <div class="kontakt-services">
        {services.cards.map((c) => (
          <a
            href={c.href}
            target={c.external ? "_blank" : undefined}
            rel={c.external ? "noopener" : undefined}
            class="kontakt-service"
          >
            <span class="kontakt-service__num">{c.num}</span>
            <h3 set:html={c.titleHtml}></h3>
            <p set:html={c.descHtml}></p>
            <span class="kontakt-service__meta" set:html={c.metaHtml}></span>
          </a>
        ))}
      </div>

      <div class="kontakt-bridge">
        <p set:html={services.bridge.textHtml}></p>
        <a href={services.bridge.ctaHref} class="kontakt-bridge__cta">
          {services.bridge.ctaLabel}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7H13M13 7L7 1M13 7L7 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </section>

    <!-- ===== 04 PROČ NÁM MŮŽETE DŮVĚŘOVAT ===== -->
    <section class="lp-section lp-section--alt">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{trust.eyebrowNum}</span> <Fragment set:html={trust.eyebrowHtml} /></span>
        <h2 class="lp-section__title" set:html={trust.titleHtml}></h2>
      </header>

      <div class="kontakt-trust">
        {trust.items.map((t) => (
          <article class="kontakt-trust__item">
            <h3 set:html={t.titleHtml}></h3>
            <p set:html={t.descHtml}></p>
          </article>
        ))}
      </div>
    </section>

    <!-- ===== 05 ČASTÉ OTÁZKY ===== -->
    <section class="lp-section lp-section--faq">
      <Faq
        items={faq.items}
        eyebrowNum={faq.eyebrowNum}
        eyebrow={faq.eyebrow}
        titleHtml={faq.titleHtml}
        leadHtml={faq.leadHtml}
      />
    </section>

    <!-- ===== 06 FAKTURAČNÍ ÚDAJE A SÍDLO ===== -->
    <section class="lp-section">
      <header class="lp-section__head">
        <span class="eyebrow"><span class="eyebrow__num">{direct.eyebrowNum}</span> <Fragment set:html={direct.eyebrowHtml} /></span>
        <h2 class="lp-section__title" set:html={direct.titleHtml}></h2>
      </header>

      <div class="kontakt-direct">
        <div class="kontakt-direct__col">
          <h3>{direct.contactsHeading}</h3>
          <dl class="kontakt-direct__list">
            {direct.contactRows.map((r) => (
              <div>
                <dt>{r.dt}</dt>
                <dd set:html={r.ddHtml}></dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="kontakt-direct__col">
          <h3>{direct.billingHeading}</h3>
          <dl class="kontakt-direct__list">
            {direct.billingRows.map((r) => (
              <div>
                <dt>{r.dt}</dt>
                <dd set:html={r.ddHtml}></dd>
              </div>
            ))}
          </dl>

          <p class="kontakt-direct__legal" set:html={direct.legalHtml}></p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Paleta Sniper Design je globalni (global.css). Tady jen dva aliasy,
     ktere pouzivaji akcentove CTA teto stranky. */
  .kontakt {
    --lp-violet: var(--sd-violet);
    --lp-magenta: var(--sd-magenta);
  }

  /* ===== HERO — Sniper Design brand box ===== */
  .kontakt-hero {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: clamp(1.5rem, 3vw, 2.5rem) var(--space-section-x) clamp(2rem, 4vw, 3.5rem);
  }
  .kontakt-hero__inner {
    background:
      radial-gradient(ellipse 70% 60% at 110% 0%, color-mix(in oklch, var(--sd-magenta) 30%, transparent), transparent 60%),
      radial-gradient(ellipse 80% 70% at -10% 100%, color-mix(in oklch, var(--sd-violet) 32%, transparent), transparent 60%),
      linear-gradient(135deg, var(--sd-deep) 0%, var(--sd-deeper) 100%);
    color: var(--sd-paper);
    border-radius: 14px;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.75rem, 4vw, 3.5rem);
    position: relative;
    overflow: hidden;
  }
  .kontakt-hero__inner::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--sd-violet) 0%, var(--sd-magenta) 100%);
  }
  /* Logo vlevo, odznaky partnerstvi vpravo — prvni radek stranky (od 14. 10. 2026).
     Odznaky tu jsou nejviditelnejsi, a pritom kontaktum neuberou misto pod H1. */
  .kontakt-hero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .kontakt-hero__brand {
    display: inline-block;
  }
  .kontakt-hero__brand img {
    width: 200px;
    height: auto;
  }
  .kontakt-hero__title {
    font-family: var(--font-agency);
    font-weight: 300;
    font-size: clamp(1.875rem, 4.5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--sd-paper);
    margin: 0 0 1.25rem;
    max-width: 38rem;
  }
  .kontakt-hero__title :global(strong) {
    font-weight: 700;
    color: color-mix(in oklch, var(--sd-magenta) 60%, white);
  }
  .kontakt-hero__lead {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.6;
    color: oklch(from var(--sd-paper) l c h / 0.85);
    margin: 0 0 1.75rem;
    max-width: 38rem;
  }
  .kontakt-hero__lead :global(a) {
    color: color-mix(in oklch, var(--sd-magenta) 60%, white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .kontakt-hero__lead :global(strong) { color: var(--sd-paper); font-weight: 600; }

  /* Trust strip — 4 položky */
  .kontakt-hero__trust {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    padding: 1.5rem 0;
    margin: 0 0 1.75rem;
    border-top: 1px solid oklch(from var(--sd-paper) l c h / 0.15);
    border-bottom: 1px solid oklch(from var(--sd-paper) l c h / 0.15);
  }
  @media (min-width: 640px) {
    .kontakt-hero__trust { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 960px) {
    .kontakt-hero__trust { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  }
  .kontakt-hero__trust li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .kontakt-hero__trust strong {
    font-family: var(--font-agency);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--sd-paper);
    letter-spacing: -0.01em;
  }
  .kontakt-hero__trust span {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.4;
    color: oklch(from var(--sd-paper) l c h / 0.7);
  }
  .kontakt-hero__trust :global(a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: oklch(from var(--sd-paper) l c h / 0.3);
  }

  /* Actions — CTA buttons */

  /* ===== Kontaktni dlazdice v hero (od 22. 9. 2026) =====
     Telefon, e-mail a formular jsou prvni obsah stranky. Drive tu stala dve
     tlacitka, ktera vedla na Pack a na web agentury — tedy nikam, kde se da
     ozvat. Odkazy jsou v set:html, proto :global() (CLAUDE.md § VI). */
  /* Flex, ne mrizka: dlazdice maji sirku podle obsahu, takze se e-mail na desktopu
     vejde na jeden radek (v pevne mrizce 2 x 358 px se lamal). Na uzkem displeji
     jdou pod sebe na celou sirku. */
  .kontakt-hero__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    margin: 0 0 clamp(1.75rem, 3vw, 2.25rem);
    padding: 0;
    list-style: none;
  }
  .kontakt-contact {
    flex: 1 1 100%;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.125rem;
    border-radius: 10px;
    background: oklch(from var(--sd-paper) l c h / 0.07);
    border: 1px solid oklch(from var(--sd-paper) l c h / 0.14);
  }
  @media (min-width: 640px) {
    .kontakt-contact { flex: 0 1 auto; min-width: 14rem; }
  }
  .kontakt-contact__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: oklch(from var(--sd-gold) l c h / 0.85);
  }
  .kontakt-contact__value {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 600;
    color: var(--sd-paper);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .kontakt-contact__value:hover { text-decoration: underline; text-underline-offset: 3px; }
  .kontakt-contact__note {
    font-size: 0.8rem;
    line-height: 1.4;
    color: oklch(from var(--sd-paper) l c h / 0.72);
  }

  /* Odznaky partnerstvi — komponenta nese vlastni styl, tady jen odsazeni
     a barvy pro tmave pozadi hero. */
  .kontakt-hero__partners {
    /* 14. 10. 2026: odznaky maji byt viditelnejsi — o petinu vetsi a se zlatym
       okrajem misto bileho. Velikost i barvy jdou pres promenne komponenty.
       Na uzkem displeji vychozi velikost: pri 1,2 se odznak Upgates lamal do
       tri radku a odsouval kontakty. */
    --partner-scale: 1;
    /* Barvy odznaku se komponente predavaji PROMENNYMI, ne pres :global().
       22. 9. 2026 tu byl primy zapis `:global(.partner) { color: … }`, ktery
       prebil jen popredi — pozadi zustalo bile z fallbacku komponenty a text
       zmizel bila na bile. Stejne ctyri promenne pouziva /audit/ i oba bloky
       Sniper Design. */
    --partner-fg: var(--sd-paper);
    --partner-muted: color-mix(in oklch, var(--sd-paper) 72%, transparent);
    --partner-border: color-mix(in oklch, var(--sd-gold) 70%, transparent);
    --partner-bg: color-mix(in oklch, var(--sd-gold) 12%, transparent);
  }

  @media (min-width: 640px) {
    .kontakt-hero__partners { --partner-scale: 1.2; }
  }

  /* ===== 02 Kdo jsme — medailonek (od 14. 10. 2026) =====
     Text drzi --w-read a stejny levy okraj jako hlavicka sekce (dve sirky, § VI).
     Odkazy jsou v set:html, proto :global(a). */
  /* Sirku nesou odstavce, ne obal: `.lp-section--alt > *` dava primym potomkum
     max-width: var(--max-section) a ma vyssi specificitu (trida + 2 atributy),
     takze `.kontakt-about { max-width }` prebil a text bezel pres 1 280 px. */
  .kontakt-about__p,
  .kontakt-about__more {
    max-width: var(--w-read);
  }
  .kontakt-about__p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
    margin: 0 0 1rem;
  }
  .kontakt-about__p--lead {
    font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
    line-height: 1.6;
    color: var(--color-ink);
  }
  .kontakt-about__p :global(strong) { color: var(--color-ink); font-weight: 600; }
  .kontakt-about__p :global(a),
  .kontakt-about__more a {
    color: var(--lp-violet);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .kontakt-about__more {
    margin: 1.5rem 0 0;
    font-weight: 600;
  }

  /* ===== Mini legal line pod hero ===== */
  .kontakt-hero__legal {
    margin: 1.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: oklch(from var(--sd-paper) l c h / 0.55);
  }
  .kontakt-hero__legal :global(strong) {
    color: oklch(from var(--sd-paper) l c h / 0.85);
    font-weight: 700;
  }

  /* ===== Sdílené primitivy z /pack/ ===== */
  .lp-section {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) var(--space-section-x);
  }
  /* Sekce už dává rám i svislý odstup — komponentě FAQ je vypneme,
     jinak by se odsazení sečetlo dvakrát. */
  .lp-section--faq {
    --faq-px: 0;
    --faq-my: 0;
  }
  .lp-section--alt {
    background: var(--color-paper-deep);
    max-width: none;
    padding-left: 0;
    padding-right: 0;
  }
  .lp-section--alt > * {
    max-width: var(--max-section);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--space-section-x);
    padding-right: var(--space-section-x);
  }
  .lp-section__head {
    max-width: 50rem;
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
  }
  .lp-section__title {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0 0 1rem;
  }
  .lp-section__title :global(strong) {
    color: var(--lp-violet);
    font-weight: 700;
  }
  .lp-section__lead {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0;
    max-width: 40rem;
  }
  .lp-section__lead :global(strong) { color: var(--color-ink); font-weight: 600; }

  .eyebrow {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: 1rem;
  }
  .eyebrow__num {
    color: var(--lp-violet);
    font-weight: 700;
  }

  /* ===== Services grid (6 services) ===== */
  .kontakt-services {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  @media (min-width: 640px) {
    .kontakt-services { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1080px) {
    .kontakt-services { grid-template-columns: repeat(3, 1fr); }
  }
  .kontakt-service {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    padding: 1.5rem 1.375rem 1.25rem;
    text-decoration: none;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }
  .kontakt-service:hover {
    border-color: var(--lp-violet);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -10px oklch(from var(--lp-violet) l c h / 0.25);
  }
  .kontakt-service__num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--lp-violet);
    letter-spacing: 0.08em;
  }
  .kontakt-service h3 {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin: 0;
  }
  .kontakt-service p {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
    margin: 0;
    flex: 1;
  }
  .kontakt-service__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
    letter-spacing: 0.02em;
    padding-top: 0.625rem;
    margin-top: 0.25rem;
    border-top: 1px dashed var(--color-rule);
  }

  /* ===== Bridge to Pack (po sekci 01) ===== */
  .kontakt-bridge {
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    padding: 1.25rem 1.5rem;
    background: oklch(0.96 0.05 305 / 0.5);
    border: 1px solid oklch(from var(--lp-violet) l c h / 0.2);
    border-left: 3px solid var(--lp-violet);
    border-radius: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }
  .kontakt-bridge p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-ink);
    flex: 1 1 24rem;
  }
  .kontakt-bridge p :global(strong) { font-weight: 600; }
  .kontakt-bridge__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: #fff;
    background: var(--lp-violet);
    padding: 0.625rem 1.125rem;
    border-radius: 999px;
    text-decoration: none;
    flex-shrink: 0;
