---
import BaseLayout from "~/layouts/BaseLayout.astro";
import SniperDesignBigContact from "~/components/sniperdesign/BigContact.astro";
import * as p from "~/content/pages/sluzby";
import { buildFaqJsonLd } from "~/lib/jsonld";

/**
 * /sluzby/ — prodejní landing „Editorial důkaz" (koncept A, 2026-08).
 *
 * Vizuální jazyk: prémiový editorial — hairline linky, obří číslice,
 * „účetní výkaz" důkazů s tečkovanými vodicími linkami, stylizovaná GSC
 * karta v hero. Důkazy nesou přesvědčení, grafika ustupuje.
 *
 * Obsah: content/pages/sluzby.ts (per-mutace). Kotvy #kroky, #moduly a #obsah
 * jsou odkazované z detailních stránek retainerů — neměnit bez redirectu.
 * ProofStrip tu záměrně není: jeho čísla nese ledger, duplikace by je oslabila.
 */
const jsonLd = [buildFaqJsonLd(p.faq), p.offerCatalogJsonLd];

/** Glyf vlivu — mono, bez emoji (editorial tón): ● velký · ◐ střední · ○ menší */
const impactGlyph: Record<number, string> = { 3: "●", 2: "◐", 1: "○" };
const impactLabel: Record<number, string> = { 3: "velký vliv", 2: "střední vliv", 1: "menší vliv" };
const modulesByImpact = [...p.modules].sort((a, b) => b.impact - a.impact);

/** Disciplínové barvy kroků: audit=accent, technika=AI Mode, obsah=AEO. */
const stepColors = [
  "--sc: var(--color-accent); --sc-strong: var(--color-accent-strong); --sc-tint: var(--color-praxe-tint)",
  "--sc: var(--color-aimode); --sc-strong: var(--color-aimode); --sc-tint: var(--color-aimode-tint)",
  "--sc: var(--color-aeo); --sc-strong: var(--color-aeo); --sc-tint: var(--color-aeo-tint)",
];
---

<BaseLayout
  title={p.meta.title}
  description={p.meta.description}
  image={p.meta.ogImage}
  jsonLd={jsonLd}
  breadcrumb={[{ label: "Služby", href: "/sluzby/" }]}
>
  <div class="ed">
    <!-- ===== HERO ===== -->
    <section class="hero" aria-labelledby="hero-title">
      <p class="hero__kicker r">{p.hero.kicker}</p>
      <h1 id="hero-title" class="hero__title r r2" set:html={p.hero.titleHtml}></h1>
      <div class="hero__grid">
        <div class="r r3">
          <p class="hero__lead" set:html={p.hero.lead}></p>
          <div class="hero__cta">
            <a class="btn btn--ink" href={p.hero.ctaPrimary.href}>{p.hero.ctaPrimary.label} <span aria-hidden="true">→</span></a>
            <a class="btn btn--ghost" href={p.hero.ctaSecondary.href}>{p.hero.ctaSecondary.label}</a>
          </div>
          <p class="hero__trust">{p.hero.trustLine}</p>
        </div>

        <figure class="shot r r4" aria-label={p.heroShot.ariaLabel}>
          <div class="shot__bar">
            <span class="shot__dot"></span><span class="shot__dot"></span><span class="shot__dot"></span>
            <span class="shot__title">{p.heroShot.barTitle}</span>
          </div>
          <div class="shot__body">
            <p class="shot__metric">{p.heroShot.metric} <small>{p.heroShot.metricUnit}</small></p>
            <p class="shot__sub">{p.heroShot.sub}</p>
            <div class="spark" aria-hidden="true">
              {p.heroShot.bars.map((h, i) => (
                <i style={`height:${h}%;animation-delay:${0.4 + i * 0.04}s`}></i>
              ))}
            </div>
          </div>
        </figure>
      </div>
    </section>

    <!-- ===== VÝKAZ DŮKAZŮ ===== -->
    <section class="ledger" aria-label="Výsledky z vlastních dat">
      <div class="ledger__head">
        <span>{p.ledger.headLeft}</span>
        <span>{p.ledger.headRight}</span>
      </div>
      {p.ledger.rows.map((row) => (
        <div class={`lrow${row.hi ? " lrow--hi" : ""}`}>
          <span class="lrow__label">{row.label}</span>
          <span class="lrow__leader" aria-hidden="true"></span>
          <span class="lrow__value">{row.value}<small>{row.unit}</small></span>
        </div>
      ))}
      <p class="ledger__src" set:html={p.ledger.srcHtml}></p>
    </section>

    <!-- ===== TŘI KROKY ===== -->
    <section class="steps" id="kroky" aria-labelledby="steps-title">
      <h2 id="steps-title" class="steps__intro" set:html={p.steps.introHtml}></h2>

      {p.steps.items.map((s, idx) => (<>
        <article class="step" id={idx === 1 ? "moduly" : undefined} style={stepColors[idx]}>
          <div>
            <div class="step__num">{s.num}</div>
            <p class="step__meta">{s.meta}</p>
          </div>
          <div>
            <h3>{s.title}</h3>
            <p class="step__desc">{s.desc}</p>

            <p class="step__price" set:html={s.priceHtml}></p>
          </div>
        </article>

        {idx === 1 && (
          <div class="mods-wrap">
            <div class="mods">
              {modulesByImpact.map((m) => (
                <article class={`mcard mcard--${m.impact}`}>
                  <span class={`mcard__impact mcard__impact--${m.impact}`}>
                    <span aria-hidden="true">{impactGlyph[m.impact]}</span> {impactLabel[m.impact]}
                  </span>
                  <h4 class="mcard__name">{m.name}</h4>
                  <p class="mcard__desc">{m.desc}</p>
                </article>
              ))}
            </div>
            <p class="step__legend">{p.modulesFoot.impactLegend}</p>
            <p class="step__platform" set:html={p.modulesFoot.platformNoteHtml}></p>
          </div>
        )}
      </>))}
    </section>

    <!-- ===== CENÍK OBSAHU ===== -->
    <section class="content" id="obsah" aria-labelledby="content-title">
      <div class="ledger__head">
        <span>{p.stepContent.eyebrow}</span>
        <span>ceny bez DPH</span>
      </div>
      <h2 id="content-title" class="content__title" set:html={p.stepContent.titleHtml}></h2>
      <p class="content__lead">{p.stepContent.lead}</p>

      {[p.categoryTiers, p.productTiers].map((group, gi) => (
        <div class="ctable" style={gi === 0
          ? "--gc: var(--color-aeo); --gc-tint: var(--color-aeo-tint); --gc-soft: var(--color-aeo-soft)"
          : "--gc: var(--color-geo); --gc-tint: var(--color-geo-tint); --gc-soft: var(--color-geo-soft)"}>
          <h3 class="ctable__title">{group.title}</h3>
          <p class="ctable__lead">{group.lead}</p>
          <div class="tiers">
            {group.tiers.map((tier) => (
              <article class={`tier${tier.featured ? " tier--hi" : ""}`}>
                {tier.badge && <span class="tier__badge">{tier.badge}</span>}
                <h4 class="tier__name">{tier.name}</h4>
                <p class="tier__desc">{tier.desc}</p>
                <p class="tier__price">{tier.unitPrice} <small>{tier.unit}</small></p>
                <p class="tier__analysis">+ {tier.analysis}</p>
                <ul class="tier__items" role="list">
                  {tier.items.map((i) => (
                    <li>
                      <span class="step__glyph" aria-label={impactLabel[i.impact]} title={impactLabel[i.impact]}>{impactGlyph[i.impact]}</span>
                      {i.label}
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      ))}

      <div class="crow crow--compare">
        <div class="crow__main">
          <span class="crow__name">{p.compareOffer.name}</span>
          <span class="crow__detail">{p.compareOffer.detail}</span>
        </div>
        <span class="lrow__leader" aria-hidden="true"></span>
        <div class="crow__buy">
          <span class="crow__price">{p.compareOffer.price} <small>{p.compareOffer.unit}</small></span>
        </div>
      </div>

      <aside class="analysis">
        <h3>{p.stepContent.analysisTitle}</h3>
        <p set:html={p.stepContent.analysisHtml}></p>
      </aside>
    </section>

    <!-- ===== AUDIT NABÍDKA ===== -->
    <section class="offer" id="audit" aria-labelledby="offer-title">
      <div>
        <h2 id="offer-title" class="offer__title" set:html={p.offer.titleHtml}></h2>
        <p class="offer__lead">{p.offer.lead}</p>
        <ul class="offer__list" role="list">
          {p.offer.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="offer__buy">
        <p class="offer__price">{p.offer.price}</p>
        <p class="offer__vat">{p.offer.vat}</p>
        <a class="btn btn--ink" href={p.offer.cta.href}>{p.offer.cta.label} <span aria-hidden="true">→</span></a>
        <p class="offer__risk">{p.offer.risk}</p>
      </div>
    </section>

    <!-- ===== DLOUHODOBĚ ===== -->
    <section class="ret" aria-labelledby="ret-title">
      <div class="ledger__head">
        <span>{p.retainers.eyebrow}</span>
        <span>měsíční spolupráce</span>
      </div>
      <h2 id="ret-title" class="content__title" set:html={p.retainers.titleHtml}></h2>
      <p class="content__lead">{p.retainers.lead}</p>
      <div class="ret__grid">
        {p.retainers.items.map((r) => (
          <a class="ret__card" href={r.href}>
            <span class="ret__type">{r.type}</span>
            <h3>{r.name}</h3>
            <p>{r.desc}</p>
            <span class="ret__cta">Detail služby <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
      <p class="ret__measure">{p.retainers.measureNote}</p>
    </section>

    <!-- ===== SELF-CHECK ===== -->
    <section class="check-sec" aria-labelledby="check-title">
      <div class="ledger__head">
        <span>{p.selfCheck.eyebrow}</span>
        <span class="check__meter" data-check-progress>
          {p.selfCheck.progressTemplate.replace("{n}", "0").replace("{total}", String(p.selfCheck.items.length))}
        </span>
      </div>
      <h2 id="check-title" class="content__title" set:html={p.selfCheck.titleHtml}></h2>
      <p class="content__lead">{p.selfCheck.lead}</p>

      <div class="check" id="ai-selfcheck" data-progress-template={p.selfCheck.progressTemplate}>
        <ul class="check__list" role="list">
          {p.selfCheck.items.map((item) => (
            <li>
              <label class="check__label">
                <input type="checkbox" class="check__box" />
                <span>{item}</span>
              </label>
            </li>
          ))}
        </ul>
        <div class="check__bar" aria-hidden="true"><div class="check__fill" data-check-fill></div></div>
        <div class="check__foot">
          <p class="check__hint">{p.selfCheck.hint}</p>
          <a href={p.selfCheck.ctaHref} class="btn btn--ink">{p.selfCheck.cta} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- ===== MÝTY ===== -->
    <section class="myths-sec" aria-labelledby="myths-title">
      <div class="ledger__head">
        <span>{p.myths.eyebrow}</span>
        <span></span>
      </div>
      <h2 id="myths-title" class="content__title" set:html={p.myths.titleHtml}></h2>
      <p class="content__lead">{p.myths.lead}</p>
      <div class="myths">
        {p.myths.items.map((m) => (
          <article class="myth">
            <h3>{m.name}</h3>
            <p>{m.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="faq-sec" aria-labelledby="faq-title">
      <div class="ledger__head">
        <span>{p.faqHead.eyebrow}</span>
        <span></span>
      </div>
      <h2 id="faq-title" class="content__title" set:html={p.faqHead.titleHtml}></h2>
      <div class="faq">
        {p.faq.map((f, i) => (
          <details class="faq__item" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- ===== FINÁLNÍ CTA ===== -->
    <section class="final" aria-labelledby="final-title">
      <h2 id="final-title" class="final__title" set:html={p.finalCta.titleHtml}></h2>
      <p class="final__lead">{p.finalCta.lead}</p>
      <div class="final__btns">
        <a class="btn btn--ink" href={p.finalCta.btnPrimary.href}>{p.finalCta.btnPrimary.label} <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={p.finalCta.btnSecondary.href}>{p.finalCta.btnSecondary.label}</a>
      </div>
    </section>

    <SniperDesignBigContact eyebrowNum="07" />
  </div>
</BaseLayout>

<script>
  /** Self-check: počítadlo zaškrtnutých položek (bez ukládání, čistě klientské). */
  const root = document.getElementById("ai-selfcheck");
  if (root) {
    const boxes = root.querySelectorAll<HTMLInputElement>(".check__box");
    const progress = document.querySelector("[data-check-progress]");
    const template = root.getAttribute("data-progress-template") ?? "{n} / {total}";
    const fill = document.querySelector<HTMLElement>("[data-check-fill]");
    const update = () => {
      const n = [...boxes].filter((b) => b.checked).length;
      if (progress)
        progress.textContent = template.replace("{n}", String(n)).replace("{total}", String(boxes.length));
      if (fill) fill.style.width = `${(n / boxes.length) * 100}%`;
    };
    boxes.forEach((b) => b.addEventListener("change", update));
  }
</script>

<style>
  /* ============ EDITORIAL ZÁKLAD ============ */
  .ed {
    /* Kontejner dle standardu webu (--max-section = 80rem, stejné jako
       všechny ostatní stránky) — vlastní šířka by rozbila zarovnání
       s headerem a zbytkem webu. */
    max-width: var(--max-section);
    margin: 0 auto;
    padding: 0 var(--space-section-x);
    font-size: 1.03rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.98rem;
    text-decoration: none;
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .btn--ink { background: var(--color-ink); color: var(--color-paper); }
  .btn--ink:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -14px oklch(0.2 0.012 260 / 0.55); }
  .btn--ghost { border: 1px solid var(--color-rule-strong); color: var(--color-ink); }
  .btn--ghost:hover { border-color: var(--color-ink); }

  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  .r { animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .r2 { animation-delay: 0.12s; }
  .r3 { animation-delay: 0.24s; }
  .r4 { animation-delay: 0.36s; }
  @media (prefers-reduced-motion: reduce) {
    .r { animation: none; }
    .spark i { animation: none !important; }
    .btn { transition: none; }
  }

  /* mono „hlavička výkazu" — sdílený vzor sekcí */
  .ledger__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  /* ============ HERO ============ */
  .hero {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    position: relative;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: -20% -30% 0;
    background:
      radial-gradient(46rem 26rem at 92% 8%, oklch(0.55 0.25 305 / 0.1), transparent 60%),
      radial-gradient(40rem 24rem at 70% 30%, oklch(0.52 0.18 250 / 0.09), transparent 55%);
    pointer-events: none;
    z-index: -1;
  }
  .hero__kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    display: flex;
    gap: 1rem;
    align-items: center;
    margin: 0;
  }
  .hero__kicker::after { content: ""; flex: 1; height: 1px; background: var(--color-rule); }
  .hero__title {
    font-family: var(--font-sans);
    font-weight: 250;
    font-size: clamp(2.3rem, 6vw, 4.9rem);
    line-height: 1.03;
    letter-spacing: -0.045em;
    margin: 1.5rem 0 0;
    max-width: 20ch;
  }
  .hero__title :global(strong) { font-weight: 600; }
  .hero__title :global(.u) { box-shadow: inset 0 -0.14em 0 oklch(0.52 0.18 250 / 0.28); }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-top: 2.25rem;
  }
  .hero__lead { font-size: clamp(1rem, 1.5vw, 1.18rem); color: var(--color-ink-muted); max-width: 36rem; margin: 0; }
  .hero__lead :global(strong) { color: var(--color-ink); font-weight: 600; }
  .hero__cta { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 1.75rem; align-items: center; }
  .hero__trust { font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-ink-faint); margin: 1rem 0 0; }

  .shot {
    border: 1px solid var(--color-rule);
    border-radius: 14px;
    background: var(--color-paper);
    box-shadow: 0 30px 60px -30px oklch(0.3 0.05 260 / 0.35);
    overflow: hidden;
    margin: 0;
  }
  .shot__bar { display: flex; gap: 0.4rem; padding: 0.65rem 0.9rem; border-bottom: 1px solid var(--color-rule); align-items: center; }
  .shot__dot { width: 9px; height: 9px; border-radius: 50%; background: var(--color-rule-strong); opacity: 0.5; }
  .shot__title { font-family: var(--font-mono); font-size: 0.66rem; color: var(--color-ink-faint); margin-left: 0.35rem; }
  .shot__body { padding: 1.1rem 1.2rem 1.3rem; }
  .shot__metric { font-family: var(--font-mono); font-size: clamp(1.8rem, 3vw, 2.5rem); letter-spacing: -0.02em; margin: 0; }
  .shot__metric small { font-size: 0.62em; color: var(--color-ink-faint); }
  .shot__sub { font-size: 0.8rem; color: var(--color-ink-muted); margin: 0.15rem 0 0; }
  .spark { display: flex; align-items: flex-end; gap: 3px; height: 74px; margin-top: 1rem; }
  .spark i {
    flex: 1;
    background: linear-gradient(180deg, oklch(0.62 0.16 250 / 0.9), var(--color-accent));
    border-radius: 2px 2px 0 0;
    transform-origin: bottom;
    animation: grow 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }

  /* ============ LEDGER — tmavá důkazová karta (jazyk ProofStrip) ============ */
  .ledger {
    margin-top: clamp(4rem, 9vw, 7rem);
    border-radius: 24px;
    background:
      radial-gradient(120% 160% at 85% -20%, oklch(0.42 0.14 264 / 0.55), transparent 55%),
      radial-gradient(100% 140% at 0% 110%, oklch(0.4 0.1 155 / 0.35), transparent 50%),
      oklch(0.21 0.03 262);
    color: oklch(0.97 0.005 250);
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.25rem);
    box-shadow:
      0 32px 80px -32px oklch(0.2 0.06 262 / 0.55),
      0 6px 16px -8px oklch(0.2 0.06 262 / 0.3);
  }
  .ledger .ledger__head { color: oklch(0.78 0.05 250); }
  .lrow { display: flex; align-items: baseline; gap: 1rem; padding: 1.35rem 0; border-bottom: 1px solid oklch(1 0 0 / 0.14); }
  .lrow:last-of-type { border-bottom: 0; }
  .lrow__label { font-size: clamp(1rem, 1.6vw, 1.25rem); font-weight: 500; letter-spacing: -0.01em; flex-shrink: 0; max-width: 26rem; }
  .lrow__leader { flex: 1; border-bottom: 2px dotted oklch(1 0 0 / 0.25); transform: translateY(-6px); min-width: 2rem; }
  .lrow__value { font-family: var(--font-mono); font-size: clamp(1.6rem, 3.4vw, 2.8rem); letter-spacing: -0.03em; white-space: nowrap; }
  .lrow__value small { font-size: 0.45em; color: oklch(0.75 0.03 255); }
  .lrow--hi .lrow__value { color: oklch(0.82 0.12 250); text-shadow: 0 0 30px oklch(0.6 0.18 250 / 0.5); }
  .ledger__src { font-family: var(--font-mono); font-size: 0.72rem; color: oklch(0.68 0.03 255); padding-top: 1rem; margin: 0; border-top: 1px solid oklch(1 0 0 / 0.14); }
  .ledger__src :global(a) { color: oklch(0.82 0.09 250); }

  /* ============ KROKY ============ */
  .steps { margin-top: clamp(4.5rem, 10vw, 8rem); }
  .steps__intro {
    font-family: var(--font-sans);
    font-weight: 250;
    font-size: clamp(1.9rem, 4vw, 3.1rem);
    letter-spacing: -0.04em;
    line-height: 1.05;
    max-width: 22ch;
    margin: 0;
  }
  .steps__intro :global(strong) { font-weight: 600; }
  .step {
    display: grid;
    grid-template-columns: minmax(0, 0.5fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(2rem, 4.5vw, 3.25rem) 0;
    border-top: 1px solid var(--color-rule);
    margin-top: 2.5rem;
  }
  .step:first-of-type { margin-top: 3rem; }
  .step { border-top-color: var(--sc, var(--color-rule)); border-top-width: 2px; }
  .step__num {
    font-family: var(--font-mono);
    font-size: clamp(3.4rem, 8vw, 6.2rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--sc, oklch(0.9 0.01 260));
    opacity: 0.28;
  }
  .step__meta { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sc-strong, var(--color-accent-strong)); margin: 0.9rem 0 0; }
