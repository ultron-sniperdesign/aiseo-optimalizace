---
import BaseLayout from "~/layouts/BaseLayout.astro";
import SniperDesignBigContact from "~/components/sniperdesign/BigContact.astro";
import ProofStrip from "~/components/blocks/ProofStrip.astro";
import * as p from "~/content/pages/sluzby";
import { buildFaqJsonLd } from "~/lib/jsonld";

/**
 * /sluzby/ — kompletní nabídka SEO pro AI (obsah: content/pages/sluzby.ts).
 *
 * Přestavba 2026-08: index už není katalog interní kolekce `services`, ale
 * prezentace finální nabídky (balíčky → audit → moduly → obsah → měření →
 * retainery → self-check → mýty → FAQ). Detailní stránky /sluzby/<slug>/
 * z kolekce zůstávají beze změny ([slug].astro) — odkazujeme na ně tam,
 * kde do nabídky mapují (retainery).
 */
const jsonLd = [buildFaqJsonLd(p.faq), p.offerCatalogJsonLd];

const impactFire = (n: number) => "🔥".repeat(n);
const impactLabel: Record<number, string> = { 3: "velký vliv", 2: "střední vliv", 1: "menší vliv" };
const contactHref = (slug: string) => `/kontakt/?sluzba=${slug}`;
---

<BaseLayout
  title={p.meta.title}
  description={p.meta.description}
  image={p.meta.ogImage}
  jsonLd={jsonLd}
  breadcrumb={[{ label: "Služby", href: "/sluzby/" }]}
>
  <div class="sl">
    <!-- ===== HERO ===== -->
    <section class="sluzby-hero">
      <span class="sluzby-hero__intro">{p.hero.intro}</span>
      <h1 class="display sluzby-hero__title" set:html={p.hero.title}></h1>
      <p class="lead sluzby-hero__lead">{p.hero.lead}</p>
      <ul class="sluzby-hero__chips" role="list">
        {p.hero.chips.map((c) => <li>{c}</li>)}
      </ul>
    </section>

    <!-- ===== 01 JAK TO FUNGUJE ===== -->
    <section class="sl-section" aria-labelledby="funnel-title">
      <header class="sl-head">
        <span class="eyebrow"><span class="eyebrow__num">{p.funnel.eyebrowNum}</span> {p.funnel.eyebrow}</span>
        <h2 id="funnel-title" class="sl-title" set:html={p.funnel.title}></h2>
        <p class="sl-lead">{p.funnel.lead}</p>
      </header>
      <ol class="funnel" role="list">
        {p.funnel.steps.map((s) => (
          <li class="funnel__step">
            <span class="funnel__num">{s.num}</span>
            <span class="funnel__label">{s.label}</span>
          </li>
        ))}
      </ol>
      <p class="funnel__note">{p.funnel.note}</p>
    </section>

    <!-- ===== 02 BALÍČKY ===== -->
    <section class="sl-section sl-section--alt" aria-labelledby="packages-title" id="balicky">
      <div class="sl-section__inner">
        <header class="sl-head">
          <span class="eyebrow"><span class="eyebrow__num">{p.packagesSection.eyebrowNum}</span> {p.packagesSection.eyebrow}</span>
          <h2 id="packages-title" class="sl-title" set:html={p.packagesSection.title}></h2>
          <p class="sl-lead">{p.packagesSection.lead}</p>
        </header>

        <div class="packs">
          {p.packages.map((pack) => (
            <article class={`pack${pack.featured ? " pack--featured" : ""}`}>
              {pack.badge && <span class="pack__badge">{pack.badge}</span>}
              <h3 class="pack__name">{pack.name}</h3>
              <p class="pack__for">{pack.forWhom}</p>
              <p class="pack__price">{pack.price}</p>
              <p class="pack__price-note">{pack.priceNote} · bez DPH</p>
              <p class="pack__saving">
                Běžná cena modulů {pack.regular} — <strong>ušetříte {pack.saving}</strong>
              </p>
              <ul class="pack__items" role="list">
                {pack.itemsPrefix && <li class="pack__items-prefix">{pack.itemsPrefix}</li>}
                {pack.items.map((i) => <li>{i}</li>)}
              </ul>
              <a href={contactHref(`balicek-${pack.featured ? "technicky" : pack.badge ? "max" : "zaklad"}`)} class={`sl-btn${pack.featured ? " sl-btn--accent" : ""}`}>
                {pack.cta} <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
        <p class="sl-vat-note">{p.packagesSection.vatNote}</p>
      </div>
    </section>

    <!-- ===== 03 AUDIT ===== -->
    <section class="sl-section" aria-labelledby="audit-title">
      <header class="sl-head">
        <span class="eyebrow"><span class="eyebrow__num">{p.stepAudit.eyebrowNum}</span> {p.stepAudit.eyebrow}</span>
        <h2 id="audit-title" class="sl-title" set:html={p.stepAudit.title}></h2>
        <p class="sl-lead">{p.stepAudit.lead}</p>
      </header>
      <aside class="audit-card">
        <div class="audit-card__body">
          <span class="audit-card__tag">Vstupní služba · pevná cena</span>
          <p class="audit-card__price">{p.stepAudit.price}</p>
          <p class="audit-card__note">{p.stepAudit.priceNote}</p>
          <p class="audit-card__for">{p.stepAudit.forWhom}</p>
        </div>
        <a href={p.stepAudit.ctaHref} class="sl-btn sl-btn--accent">
          {p.stepAudit.cta} <span aria-hidden="true">→</span>
        </a>
      </aside>
    </section>

    <!-- ===== 04 TECHNICKÉ MODULY ===== -->
    <section class="sl-section sl-section--alt" aria-labelledby="modules-title" id="moduly">
      <div class="sl-section__inner">
        <header class="sl-head">
          <span class="eyebrow"><span class="eyebrow__num">{p.stepModules.eyebrowNum}</span> {p.stepModules.eyebrow}</span>
          <h2 id="modules-title" class="sl-title" set:html={p.stepModules.title}></h2>
          <p class="sl-lead">{p.stepModules.lead}</p>
          <p class="sl-impact-legend">{p.stepModules.impactLegend}</p>
        </header>

        <div class="mods">
          {p.modules.map((m) => (
            <article class="mod">
              <span class="mod__impact" title={impactLabel[m.impact]}>
                <span aria-hidden="true">{impactFire(m.impact)}</span> {impactLabel[m.impact]}
              </span>
              <h3 class="mod__name">{m.name}</h3>
              <p class="mod__desc">{m.desc}</p>
              <div class="mod__foot">
                <span class="mod__price">{m.price}{m.price.includes("Kč") ? " bez DPH" : ""}</span>
                <a href={contactHref(m.slug)} class="mod__cta">Chci tento modul <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== 05 OBSAH ===== -->
    <section class="sl-section" aria-labelledby="content-title" id="obsah">
      <header class="sl-head">
        <span class="eyebrow"><span class="eyebrow__num">{p.stepContent.eyebrowNum}</span> {p.stepContent.eyebrow}</span>
        <h2 id="content-title" class="sl-title" set:html={p.stepContent.title}></h2>
        <p class="sl-lead">{p.stepContent.lead}</p>
      </header>

      <aside class="analysis-note">
        <h3 class="analysis-note__title">{p.stepContent.analysisTitle}</h3>
        <p class="analysis-note__text" set:html={p.stepContent.analysisHtml}></p>
      </aside>

      {[p.categoryTiers, p.productTiers].map((group) => (
        <div class="tier-group">
          <h3 class="tier-group__title">{group.title}</h3>
          <p class="tier-group__lead">{group.lead}</p>
          <div class="tiers">
            {group.tiers.map((t) => (
              <article class={`tier${t.featured ? " tier--featured" : ""}`}>
                {t.badge && <span class="pack__badge">{t.badge}</span>}
                <h4 class="tier__name">{t.name}</h4>
                <p class="tier__desc">{t.desc}</p>
                <p class="tier__price">
                  {t.unitPrice} <span class="tier__unit">/ {t.unit}</span>
                </p>
                <p class="tier__analysis">+ {t.analysis}</p>
                <ul class="tier__items" role="list">
                  {t.items.map((i) => (
                    <li>
                      {i.label} <span class="tier__impact" title={impactLabel[i.impact]} aria-label={impactLabel[i.impact]}>{impactFire(i.impact)}</span>
                    </li>
                  ))}
                </ul>
                <a href={contactHref("obsah")} class={`sl-btn${t.featured ? " sl-btn--accent" : ""}`}>
                  {t.cta} <span aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
        </div>
      ))}

      <aside class="compare-offer">
        <div class="compare-offer__body">
          <h3 class="compare-offer__title">{p.compareOffer.title}</h3>
          <p class="compare-offer__lead">{p.compareOffer.lead}</p>
        </div>
        <div class="compare-offer__buy">
          <p class="compare-offer__price">{p.compareOffer.price}</p>
          <p class="compare-offer__note">{p.compareOffer.priceNote} · bez DPH</p>
          <a href={contactHref(p.compareOffer.slug)} class="sl-btn sl-btn--accent">
            {p.compareOffer.cta} <span aria-hidden="true">→</span>
          </a>
        </div>
      </aside>
    </section>

    <!-- ===== 06 MĚŘENÍ ===== -->
    <section class="sl-section sl-section--alt" aria-labelledby="measure-title">
      <div class="sl-section__inner">
        <header class="sl-head">
          <span class="eyebrow"><span class="eyebrow__num">{p.measurement.eyebrowNum}</span> {p.measurement.eyebrow}</span>
          <h2 id="measure-title" class="sl-title" set:html={p.measurement.title}></h2>
          <p class="sl-lead">{p.measurement.lead}</p>
        </header>
        <div class="measure">
          {p.measurement.items.map((m) => (
            <article class="measure__item">
              <h3 class="measure__name">{m.name}</h3>
              <p class="measure__desc">{m.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== 07 RETAINERY ===== -->
    <section class="sl-section" aria-labelledby="retainers-title">
      <header class="sl-head">
        <span class="eyebrow"><span class="eyebrow__num">{p.retainers.eyebrowNum}</span> {p.retainers.eyebrow}</span>
        <h2 id="retainers-title" class="sl-title" set:html={p.retainers.title}></h2>
        <p class="sl-lead">{p.retainers.lead}</p>
      </header>
      <div class="rets">
        {p.retainers.items.map((r) => (
          <a href={r.href} class="ret">
            <span class="ret__type">{r.type}</span>
            <h3 class="ret__name">{r.name}</h3>
            <p class="ret__desc">{r.desc}</p>
            <p class="ret__for">{r.forWhom}</p>
            <span class="ret__cta">Detail služby <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
      <div class="rets__cta">
        <a href={contactHref("retainer")} class="sl-btn">{p.retainers.cta} <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- ===== 08 SELF-CHECK ===== -->
    <section class="sl-section sl-section--alt" aria-labelledby="check-title">
      <div class="sl-section__inner">
        <header class="sl-head">
          <span class="eyebrow"><span class="eyebrow__num">{p.selfCheck.eyebrowNum}</span> {p.selfCheck.eyebrow}</span>
          <h2 id="check-title" class="sl-title" set:html={p.selfCheck.title}></h2>
          <p class="sl-lead">{p.selfCheck.lead}</p>
        </header>

        <div class="check" id="ai-selfcheck" data-progress-template={p.selfCheck.progressTemplate}>
          <ul class="check__list" role="list">
            {p.selfCheck.items.map((item, i) => (
              <li class="check__item">
                <label class="check__label">
                  <input type="checkbox" class="check__box" data-check-index={i} />
                  <span>{item}</span>
                </label>
              </li>
            ))}
          </ul>
          <p class="check__progress" aria-live="polite" data-check-progress>
            {p.selfCheck.progressTemplate.replace("{n}", "0").replace("{total}", String(p.selfCheck.items.length))}
          </p>
          <p class="check__hint">{p.selfCheck.hint}</p>
          <a href={p.selfCheck.ctaHref} class="sl-btn sl-btn--accent">{p.selfCheck.cta} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- ===== 09 MÝTY ===== -->
    <section class="sl-section" aria-labelledby="myths-title">
      <header class="sl-head">
        <span class="eyebrow"><span class="eyebrow__num">{p.myths.eyebrowNum}</span> {p.myths.eyebrow}</span>
        <h2 id="myths-title" class="sl-title" set:html={p.myths.title}></h2>
        <p class="sl-lead">{p.myths.lead}</p>
      </header>
      <div class="myths">
        {p.myths.items.map((m) => (
          <article class="myth">
            <h3 class="myth__name">{m.name}</h3>
            <p class="myth__desc">{m.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- ===== 10 FAQ ===== -->
    <section class="sl-section sl-section--alt" aria-labelledby="faq-title">
      <div class="sl-section__inner">
        <header class="sl-head">
          <span class="eyebrow"><span class="eyebrow__num">{p.faqHead.eyebrowNum}</span> {p.faqHead.eyebrow}</span>
          <h2 id="faq-title" class="sl-title" set:html={p.faqHead.title}></h2>
        </header>
        <div class="faq">
          {p.faq.map((f, i) => (
            <details class="faq__item" open={i === 0}>
              <summary class="faq__q">{f.q}</summary>
              <p class="faq__a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== FINÁLNÍ CTA ===== -->
    <section class="final-cta">
      <div class="final-cta__inner">
        <h2 class="final-cta__title" set:html={p.finalCta.title}></h2>
        <p class="final-cta__lead">{p.finalCta.lead}</p>
        <div class="final-cta__btns">
          <a href={p.finalCta.btnPrimary.href} class="sl-btn sl-btn--accent">{p.finalCta.btnPrimary.label}</a>
          <a href={p.finalCta.btnSecondary.href} class="sl-btn">{p.finalCta.btnSecondary.label}</a>
        </div>
      </div>
    </section>

    <ProofStrip />
    <SniperDesignBigContact eyebrowNum="11" />
  </div>
</BaseLayout>

<script>
  /** Self-check: počítadlo zaškrtnutých položek (bez ukládání, čistě klientské). */
  const root = document.getElementById("ai-selfcheck");
  if (root) {
    const boxes = root.querySelectorAll<HTMLInputElement>(".check__box");
    const progress = root.querySelector("[data-check-progress]");
    const template = root.getAttribute("data-progress-template") ?? "{n} / {total}";
    const update = () => {
      const n = [...boxes].filter((b) => b.checked).length;
      if (progress)
        progress.textContent = template.replace("{n}", String(n)).replace("{total}", String(boxes.length));
    };
    boxes.forEach((b) => b.addEventListener("change", update));
  }
</script>

<style>
  /* ===== HERO (převzatý vizuál původního indexu) ===== */
  .sluzby-hero {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: clamp(3.5rem, 10vh, 7rem) var(--space-section-x) clamp(2.5rem, 5vh, 4rem);
  }
  .sluzby-hero__intro {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    padding: 0.45rem 0.875rem;
    background: var(--color-paper-deep);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    margin-bottom: 2.5rem;
  }
  .sluzby-hero__intro::before {
    content: "";
    width: 7px;
    height: 7px;
    background: var(--color-accent);
    border-radius: 50%;
  }
  .sluzby-hero__title {
    font-family: var(--font-sans);
    font-weight: 250;
    font-size: clamp(2rem, 5.5vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 2rem;
    max-width: 24ch;
  }
  .sluzby-hero__title :global(strong) { font-weight: 600; color: var(--color-ink); }
  .sluzby-hero__title :global(.hl) { color: var(--color-accent); font-weight: 400; }
  .sluzby-hero__lead {
    font-family: var(--font-sans);
    font-weight: 350;
    font-size: clamp(1rem, 1.4vw, 1.1875rem);
    line-height: 1.55;
    color: var(--color-ink-muted);
    max-width: 44rem;
    margin-bottom: 1.75rem;
  }
  .sluzby-hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
  }
  .sluzby-hero__chips li {
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    padding: 0.375rem 0.75rem;
    background: var(--color-paper);
  }

  /* ===== Sekce primitiva ===== */
  .sl-section {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) var(--space-section-x);
    scroll-margin-top: 4rem;
  }
  .sl-section--alt {
    background: var(--color-paper-deep);
    max-width: none;
    padding-left: 0;
    padding-right: 0;
  }
  .sl-section--alt .sl-section__inner {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: 0 var(--space-section-x);
  }
  .sl-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .sl-title {
    font-family: var(--font-sans);
    font-weight: 280;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin: 0;
    color: var(--color-ink);
  }
  .sl-title :global(strong) { font-weight: 600; }
  .sl-lead {
    font-size: clamp(0.975rem, 1.2vw, 1.0625rem);
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 46rem;
    margin: 0;
  }
  .sl-impact-legend {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
    margin: 0;
  }
  .sl-vat-note {
    margin: 1.5rem 0 0;
    font-size: 0.825rem;
    color: var(--color-ink-faint);
  }

  /* ===== Tlačítka ===== */
  .sl-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.7rem 1.35rem;
    border-radius: 999px;
    border: 1px solid var(--color-rule-strong);
    background: var(--color-paper);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }
  .sl-btn:hover { border-color: var(--color-ink-muted); transform: translateY(-1px); }
  .sl-btn--accent {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: oklch(0.99 0.003 250);
  }
  .sl-btn--accent:hover { background: var(--color-accent-strong); border-color: var(--color-accent-strong); }

  /* ===== 01 Funnel ===== */
  .funnel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.875rem;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .funnel__step {
    list-style: none;
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    background: var(--color-paper);
    padding: 1.25rem 1.25rem 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .funnel__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
  }
  .funnel__label {
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: -0.012em;
  }
  .funnel__note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-ink-muted);
  }

  /* ===== 02 Balíčky ===== */
  .packs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    align-items: start;
  }
  .pack {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: 14px;
    padding: 1.75rem 1.625rem;
  }
  .pack--featured {
    border-color: var(--color-accent);
    border-width: 2px;
    box-shadow: 0 14px 34px -18px oklch(from var(--color-accent) l c h / 0.4);
  }
  .pack__badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    background: var(--color-praxe-tint);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
  }
  .pack__name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .pack__for { margin: 0; font-size: 0.875rem; line-height: 1.5; color: var(--color-ink-muted); }
  .pack__price {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.9rem;
    letter-spacing: -0.03em;
    margin: 0.375rem 0 0;
    color: var(--color-ink);
  }
  .pack__price-note { margin: 0; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-faint); }
  .pack__saving { margin: 0; font-size: 0.85rem; color: var(--color-ink-muted); }
  .pack__saving strong { color: var(--color-geo); font-weight: 600; }
  .pack__items { margin: 0.625rem 0 1rem; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
