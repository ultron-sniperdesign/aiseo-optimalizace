---
import BaseLayout from "~/layouts/BaseLayout.astro";
import SniperDesignBigContact from "~/components/sniperdesign/BigContact.astro";
import ProofStrip from "~/components/blocks/ProofStrip.astro";
import { getCollection } from "astro:content";

const meta = {
  title: "Služby — kompletní AI SEO pro váš web | aiseo-optimalizace.cz",
  description:
    "Od auditu po dlouhodobou správu. 14 služeb pro SEO v AI éře — audit, GEO obsah, technická úprava, monitoring AI viditelnosti, off-page a další.",
};

const hero = {
  intro: "Komplet služeb od Sniper Design",
  title:
    '<strong>Pomáháme webům</strong>, aby je <span class="hl">citovala AI</span>.',
  lead:
    "Od auditu po dlouhodobou správu. 14 služeb, které z vašeho webu udělají zdroj, který si ChatGPT, Perplexity i Google AI Overviews vyberou k citaci. Začněte auditem a pak řešte jen to, co dává smysl pro váš web.",
};

const bucketDefs = [
  {
    key: "audit-strategie",
    num: "01",
    eyebrow: "Audit & strategie",
    title: 'Pochopit, kde stojíte a <strong>kam zamířit</strong>.',
    lead: "Vstupní vrstva — než investujete do realizace, ujasněte si plán.",
  },
  {
    key: "obsah-pro-ai",
    num: "02",
    eyebrow: "Obsah pro AI",
    title: 'Aby AI mělo <strong>co citovat</strong>.',
    lead: "Citovatelný obsah — answer blocky, fakt-density, srovnání. Píšeme s lidskou redakcí, ne masově.",
  },
  {
    key: "technika-mereni",
    num: "03",
    eyebrow: "Technika & měření",
    title: 'Strojově čitelný web + <strong>data, jestli to funguje</strong>.',
    lead: "Schema, crawlery, indexace, GA4 tracking AI traffic. Infrastrukturní vrstva, na které stojí všechno ostatní.",
  },
  {
    key: "rust-autorita",
    num: "04",
    eyebrow: "Růst & autorita",
    title: 'Dlouhodobé retainery a <strong>důkaz ROI</strong>.',
    lead: "SEO správa, monitoring AI viditelnosti, off-page program, autorita a freshness. Páteř dlouhodobé spolupráce.",
  },
  {
    key: "doplnky",
    num: "05",
    eyebrow: "Doplňky",
    title: 'Když chcete <strong>dělat víc sami</strong>.',
    lead: "Školení interního týmu, aby SEO pro AI uměli vaši lidé v rutině.",
  },
];

const personaIcon: Record<string, string> = { eshop: "🛒", firemni: "🏢" };
const personaLabel: Record<string, string> = { eshop: "E-shop", firemni: "Firemní web" };
const typeLabel: Record<string, string> = {
  vstupni: "Vstupní",
  jednorazova: "Jednorázová",
  mesicni: "Měsíční retainer",
  addon: "Doplněk",
};

// Načti všechny služby + seskup podle bucketu
const all = await getCollection("services");
const byBucket = (key: string) =>
  all.filter((s) => s.data.bucket === key).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={meta.title} description={meta.description} image="/og/default.jpg">
  <!-- HERO -->
  <section class="sluzby-hero">
    <span class="sluzby-hero__intro">{hero.intro}</span>
    <h1 class="display sluzby-hero__title" set:html={hero.title}></h1>
    <p class="lead sluzby-hero__lead">{hero.lead}</p>
  </section>

  <!-- BUCKETY -->
  {bucketDefs.map((b) => {
    const items = byBucket(b.key);
    if (items.length === 0) return null;
    return (
      <section class="bucket" id={`bucket-${b.key}`}>
        <header class="bucket__head">
          <span class="eyebrow"><span class="eyebrow__num">{b.num}</span> {b.eyebrow}</span>
          <h2 class="bucket__title" set:html={b.title} />
          <p class="bucket__lead">{b.lead}</p>
        </header>

        <div class="cards">
          {items.map((item) => {
            // Detail jen pro hasDetailPage; ostatní karty vedou na kontakt
            // s předvyplněnou službou (stejný pattern jako CTA na detailu).
            // Bez toho karty bez detailu linkovaly na 404 /sluzby/<slug>/.
            const href =
              item.data.href ??
              (item.data.hasDetailPage
                ? `/sluzby/${item.data.slug}/`
                : `/kontakt/?sluzba=${item.data.slug}`);
            return (
              <a href={href} class="card" data-bucket={b.key}>
                <div class="card__chips">
                  {item.data.personas.map((p) => (
                    <span class="chip chip--persona" title={personaLabel[p]}>
                      <span aria-hidden="true">{personaIcon[p]}</span> {personaLabel[p]}
                    </span>
                  ))}
                  <span class={`chip chip--type chip--type-${item.data.type}`}>{typeLabel[item.data.type]}</span>
                </div>
                <h3 class="card__title">{item.data.name}</h3>
                <p class="card__desc">{item.data.oneLine}</p>
                <span class="card__cta">
                  {item.data.hasDetailPage ? "Detail služby" : "Mám zájem"} <span aria-hidden="true">→</span>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    );
  })}

  <!-- FINÁLNÍ CTA -->
  <section class="final-cta">
    <div class="final-cta__inner">
      <h2 class="final-cta__title">Nevíte, kde začít?</h2>
      <p class="final-cta__lead">
        <strong>Začněte auditem.</strong> Levný, konkrétní, dá vám prioritizovaný plán — a teprve pak se rozhodněte, co dál řešit s námi a co sami.
      </p>
      <div class="final-cta__btns">
        <a href="/audit/" class="btn btn--primary">Objednat audit</a>
        <a href="/kontakt/" class="btn btn--secondary">Napište nám</a>
      </div>
    </div>
  </section>

  <!-- PROOF STRIP — 200 tis. zobrazení v AI odpovědích (trust prvek před pitch) -->
  <ProofStrip />
  <SniperDesignBigContact eyebrowNum="06" />
</BaseLayout>

<style>
  /* ===== HERO ===== */
  .sluzby-hero {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: clamp(3.5rem, 10vh, 7rem) var(--space-section-x) clamp(2.5rem, 5vh, 4rem);
  }
  .sluzby-hero__intro {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    padding: 0.45rem 0.875rem;
    background: var(--color-paper-deep);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    margin-bottom: 2.5rem;
  }
  .sluzby-hero__intro::before {
    content: "";
    width: 7px;
    height: 7px;
    background: var(--color-accent);
    border-radius: 50%;
  }
  .sluzby-hero__title {
    font-family: var(--font-sans);
    font-weight: 250;
    font-size: clamp(2rem, 5.5vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 2rem;
    max-width: 24ch;
  }
  .sluzby-hero__title :global(strong) { font-weight: 600; color: var(--color-ink); }
  .sluzby-hero__title :global(.hl) { color: var(--color-accent); font-weight: 400; }
  .sluzby-hero__lead {
    font-family: var(--font-sans);
    font-weight: 350;
    font-size: clamp(1rem, 1.4vw, 1.1875rem);
    line-height: 1.55;
    color: var(--color-ink-muted);
    max-width: 44rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* ===== BUCKETY ===== */
  .bucket {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) var(--space-section-x);
    scroll-margin-top: 4rem;
  }
  .bucket__head {
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .bucket__title {
    font-family: var(--font-sans);
    font-weight: 280;
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 28ch;
    color: var(--color-ink);
    margin: 0;
  }
  .bucket__title :global(strong) { font-weight: 600; }
  .bucket__lead {
    font-family: var(--font-sans);
    font-weight: 350;
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    color: var(--color-ink-muted);
    max-width: 42rem;
    line-height: 1.55;
    margin: 0;
  }

  /* ===== KARTY SLUŽEB ===== */
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .cards { grid-template-columns: repeat(3, 1fr); } }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.5rem;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    position: relative;
    overflow: hidden;
  }
  .card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0.15);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.5, 0, 0, 1);
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    box-shadow: 0 10px 24px -14px oklch(0.2 0.05 260 / 0.22);
  }
  .card:hover::before { transform: scaleX(1); }

  .card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
    background: var(--color-paper-deep);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    line-height: 1.2;
  }
  .chip--type-vstupni     { background: oklch(0.96 0.04 60); color: oklch(0.4 0.14 60); border-color: oklch(0.88 0.07 60); }
  .chip--type-jednorazova { background: oklch(0.96 0.025 250); color: oklch(0.42 0.16 250); border-color: oklch(0.88 0.05 250); }
  .chip--type-mesicni     { background: oklch(0.96 0.03 155); color: oklch(0.4 0.13 155); border-color: oklch(0.88 0.06 155); }
  .chip--type-addon       { background: oklch(0.96 0.03 305); color: oklch(0.42 0.14 305); border-color: oklch(0.88 0.05 305); }

  .card__title {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.012em;
    color: var(--color-ink);
    margin: 0;
  }
  .card__desc {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
    margin: 0;
    flex: 1;
  }
  .card__cta {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: gap 0.18s ease;
    margin-top: 0.25rem;
  }
  .card:hover .card__cta { gap: 0.75rem; }

  /* ===== FINAL CTA ===== */
  .final-cta {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: clamp(3rem, 5vw, 4rem) var(--space-section-x);
  }
  .final-cta__inner {
    background: linear-gradient(
      135deg,
      color-mix(in oklch, var(--color-accent) 8%, var(--color-paper)) 0%,
      color-mix(in oklch, var(--color-aio) 6%, var(--color-paper)) 100%
    );
    border: 1px solid color-mix(in oklch, var(--color-accent) 30%, var(--color-rule-strong));
    border-radius: 14px;
    padding: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }
  .final-cta__title {
    font-family: var(--font-sans);
    font-weight: 280;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-ink);
    margin: 0 0 1rem;
  }
  .final-cta__lead {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.2vw, 1.0625rem);
    line-height: 1.55;
    color: var(--color-ink-muted);
    max-width: 42rem;
    margin: 0 auto 1.75rem;
  }
  .final-cta__lead :global(strong) { font-weight: 600; color: var(--color-ink); }
  .final-cta__btns {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
  .btn {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .btn--primary {
    background: var(--color-accent);
    color: var(--color-paper);
  }
  .btn--primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px -6px oklch(0.42 0.2 250 / 0.4);
  }
  .btn--secondary {
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-rule-strong);
  }
  .btn--secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ===== EYEBROW (sdílený vzor s ostatními sekcemi) ===== */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }
  .eyebrow__num {
    background: var(--color-paper-deep);
    color: var(--color-accent);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--color-rule);
  }
</style>
