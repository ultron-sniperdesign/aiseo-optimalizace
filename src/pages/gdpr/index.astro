---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { meta, breadcrumb, lastUpdated, hero, sections } from "~/content/pages/privacy";
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  breadcrumb={[breadcrumb]}
>
  <div class="gdpr">
    <!-- ===== HERO ===== -->
    <section class="gdpr-hero">
      <div class="gdpr-hero__inner">
        <nav class="gdpr-hero__crumbs" aria-label={hero.crumbsAriaLabel}>
          <a href="/">{hero.crumbHomeLabel}</a>
          <span aria-hidden="true">›</span>
          <span>{hero.crumbCurrentLabel}</span>
        </nav>
        <h1 class="gdpr-hero__title" set:html={hero.titleHtml}></h1>
        <p class="gdpr-hero__lead" set:html={hero.leadHtml}></p>
        <p class="gdpr-hero__meta">
          <span>{hero.metaLabel} <time datetime={lastUpdated}>{lastUpdated}</time></span>
        </p>
      </div>
    </section>

    <!-- ===== BODY ===== -->
    <article class="gdpr-body">
      <div class="gdpr-body__inner">
        {sections.map((s) => (
          <section class="gdpr-section">
            <h2 class="gdpr-section__title">
              <span class="gdpr-section__num">{s.num}</span>
              <Fragment set:html={s.titleHtml} />
            </h2>
            {s.blocks.map((b) =>
              b.type === "p" ? (
                <p set:html={b.html}></p>
              ) : b.type === "sub" ? (
                <h3 class="gdpr-section__sub" set:html={b.html}></h3>
              ) : b.type === "ul" ? (
                <ul>
                  {b.items.map((item) => (
                    <li set:html={item}></li>
                  ))}
                </ul>
              ) : b.type === "processors" ? (
                <dl class="gdpr-processors">
                  {b.items.map((pr) => (
                    <div class="gdpr-processor">
                      <dt set:html={pr.dtHtml}></dt>
                      <dd set:html={pr.ddHtml}></dd>
                    </div>
                  ))}
                </dl>
              ) : (
                <ul class="gdpr-contact">
                  {b.items.map((item) => (
                    <li set:html={item}></li>
                  ))}
                </ul>
              )
            )}
          </section>
        ))}
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  /* ===== Page root ===== */
  .gdpr {
    --gdpr-violet: oklch(0.55 0.25 305);
    --gdpr-magenta: oklch(0.5 0.27 335);
  }

  /* ===== HERO ===== */
  .gdpr-hero {
    background:
      radial-gradient(ellipse 60% 50% at 100% 0%, color-mix(in oklch, var(--gdpr-magenta) 10%, transparent), transparent 60%),
      radial-gradient(ellipse 60% 60% at 0% 100%, color-mix(in oklch, var(--gdpr-violet) 8%, transparent), transparent 60%),
      var(--color-paper);
    border-bottom: 1px solid var(--color-rule);
  }
  .gdpr-hero__inner {
    max-width: 56rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) var(--space-section-x);
  }
  .gdpr-hero__crumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    margin-bottom: 1.5rem;
  }
  .gdpr-hero__crumbs a {
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .gdpr-hero__crumbs a:hover {
    color: var(--gdpr-violet);
  }
  .gdpr-hero__crumbs span[aria-hidden] {
    opacity: 0.5;
  }
  .gdpr-hero__title {
    font-family: var(--font-sans);
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 250;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--color-ink);
    margin: 0 0 1rem;
  }
  .gdpr-hero__title :global(strong) {
    font-weight: 600;
    color: var(--gdpr-violet);
  }
  .gdpr-hero__lead {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.55;
    color: var(--color-ink-muted);
    margin: 0 0 1.25rem;
    max-width: 42rem;
  }
  .gdpr-hero__lead :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .gdpr-hero__meta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
    margin: 0;
  }

  /* ===== BODY ===== */
  .gdpr-body {
    background: var(--color-paper);
  }
  .gdpr-body__inner {
    max-width: 48rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) var(--space-section-x);
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .gdpr-section {
    font-family: var(--font-sans);
  }
  .gdpr-section__title {
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.25;
    color: var(--color-ink);
    margin: 0 0 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .gdpr-section__num {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--gdpr-violet);
    flex-shrink: 0;
  }
  .gdpr-section__sub {
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 1.25rem 0 0.5rem;
  }
  .gdpr-section p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0 0 1rem;
  }
  .gdpr-section p :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .gdpr-section p :global(em) {
    font-style: italic;
    color: color-mix(in oklch, var(--gdpr-magenta) 80%, var(--color-ink));
    font-weight: 500;
  }
  .gdpr-section ul {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-ink-muted);
  }
  .gdpr-section ul li {
    margin: 0 0 0.5rem;
  }
  .gdpr-section ul li :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .gdpr-section :global(a) {
    color: var(--gdpr-violet);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--gdpr-violet) 35%, transparent);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.15s ease;
  }
  .gdpr-section :global(a:hover) {
    text-decoration-color: var(--gdpr-violet);
  }

  /* ===== Sub-processors list ===== */
  .gdpr-processors {
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .gdpr-processor {
    padding: 1rem 1.125rem;
    background: var(--color-paper-deep);
    border: 1px solid var(--color-rule);
    border-left: 3px solid var(--gdpr-violet);
    border-radius: 8px;
  }
  .gdpr-processor dt {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 0.25rem;
  }
  .gdpr-processor dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
  }

  /* ===== Contact list ===== */
  .gdpr-contact {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .gdpr-contact li {
    font-size: 1rem;
    color: var(--color-ink);
  }
</style>
