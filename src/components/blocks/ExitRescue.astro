---
/**
 * ExitRescue — „záchranná síť" na konci prodejních landing stránek.
 *
 * Proč existuje (GA4 2026-08-01): landing stránky (/navod-zdarma/, /audit/,
 * /pack/) měly v těle odkazy jen na placené produkty a GDPR. Návštěvník, který
 * nebyl připravený dát e-mail ani zaplatit, neměl kam pokračovat a odcházel
 * z webu úplně — u /navod-zdarma/ šlo zhruba o 67 z 96 uživatelů.
 *
 * Blok se vkládá VŽDY AŽ ZA hlavní CTA sekci, ne před ni — nemá s nabídkou
 * soutěžit, jen zachytit toho, kdo prošel celou stránku a stejně nekonvertoval.
 *
 * Texty i odkazy jsou props z datových modulů stránek (per-mutace překlad),
 * šablona zůstává sdílená — viz MUTATIONS.md.
 */

export interface Link {
  href: string;
  title: string;
  desc: string;
}

export interface Props {
  eyebrow: string;
  title: string;
  links: Link[];
}

const { eyebrow, title, links } = Astro.props;
---

<aside class="rescue" aria-labelledby="rescue-title">
  <div class="rescue__inner">
    <header class="rescue__head">
      <span class="rescue__eyebrow">{eyebrow}</span>
      <h2 id="rescue-title" class="rescue__title" set:html={title}></h2>
    </header>

    <div class="rescue__grid">
      {
        links.map((l) => (
          <a href={l.href} class="rescue__card">
            <span class="rescue__card-title">{l.title}</span>
            <span class="rescue__card-desc">{l.desc}</span>
            <span class="rescue__card-cta" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </div>
</aside>

<style>
  /* Tmavá karta ve stejném jazyce jako ProofStrip / FreeStrip.
     První verze měla světlé pozadí (--color-paper-deep), jenže stejné mají
     i finální CTA sekce a patička — vznikl souvislý šedý pás a blok v něm
     zanikl. Kontrastní plocha ho odděluje, aniž by z něj dělala další nabídku. */
  /* Horní odsazení je větší než spodní — blok navazuje na finální CTA sekci
     a potřebuje od ní zřetelný odstup („safe zóna"). Pozor: tyhle sekce dřív
     měly margin-bottom: -3rem kvůli doléhání na patičku; při zavedení tohoto
     bloku bylo odstraněno, jinak odsazení ukusovalo. */
  .rescue {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: clamp(3.5rem, 7vw, 6rem) var(--space-section-x) clamp(2.5rem, 5vw, 4rem);
  }
  .rescue__inner {
    border-radius: 24px;
    background:
      radial-gradient(120% 160% at 85% -20%, oklch(0.42 0.14 264 / 0.55), transparent 55%),
      radial-gradient(100% 140% at 0% 110%, oklch(0.4 0.1 155 / 0.35), transparent 50%),
      oklch(0.21 0.03 262);
    color: oklch(0.97 0.005 250);
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 2.75rem);
    box-shadow:
      0 32px 80px -32px oklch(0.2 0.06 262 / 0.55),
      0 6px 16px -8px oklch(0.2 0.06 262 / 0.3);
  }
  .rescue__head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }
  .rescue__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: oklch(0.82 0.09 250);
  }
  .rescue__title {
    font-family: var(--font-sans);
    font-weight: 280;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: oklch(0.98 0.004 250);
    margin: 0;
  }
  /* set:html potomci nedostanou Astro scope atribut -> :global() (viz CLAUDE.md § rizika) */
  .rescue__title :global(strong) {
    font-weight: 600;
  }

  .rescue__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.875rem;
  }
  .rescue__card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.375rem;
    border: 1px solid oklch(1 0 0 / 0.14);
    border-radius: 12px;
    background: oklch(1 0 0 / 0.06);
    text-decoration: none;
    color: inherit;
    position: relative;
    transition:
      border-color 0.25s ease,
      background 0.25s ease,
      transform 0.25s ease;
  }
  .rescue__card:hover {
    border-color: oklch(1 0 0 / 0.36);
    background: oklch(1 0 0 / 0.12);
    transform: translateY(-2px);
  }
  .rescue__card-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.012em;
    color: oklch(0.99 0.003 250);
  }
  .rescue__card-desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: oklch(0.84 0.012 255);
  }
  .rescue__card-cta {
    margin-top: 0.375rem;
    font-size: 1.05rem;
    color: oklch(0.82 0.09 250);
    transition:
      transform 0.25s ease,
      color 0.25s ease;
  }
  .rescue__card:hover .rescue__card-cta {
    color: oklch(0.95 0.05 250);
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .rescue__card,
    .rescue__card-cta {
      transition: none;
    }
    .rescue__card:hover,
    .rescue__card:hover .rescue__card-cta {
      transform: none;
    }
  }
</style>
