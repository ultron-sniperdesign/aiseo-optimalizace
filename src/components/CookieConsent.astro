---
/**
 * CookieConsent — lišta souhlasu s cookies.
 *
 * Proč existuje: do 22. 9. 2026 se GA4 i Meta Pixel načítaly bezpodmínečně.
 * Sec-GPC a DNT se sice respektovaly, ale to je signál menšiny prohlížečů,
 * ne souhlas podle § 89 zák. 127/2005 Sb. (opt-in od 1. 1. 2022) a GDPR.
 *
 * **Souhlas je konkrétní pro každý účel** (GDPR čl. 4 odst. 11, EDPB 05/2020).
 * Měření návštěvnosti a reklama jsou dva různé účely, takže je nejde svázat
 * do jednoho tlačítka — první verze lišty (22. 9.) to dělala a bylo to špatně.
 * Každá kategorie má vlastní přepínač a dá se přijmout zvlášť.
 *
 * Model měření: **Consent Mode v2.** GA4 se načte hned, ale s
 * `analytics_storage: denied` — posílá bezcookie pingy, takže v GA4 zůstane
 * modelovaná návštěvnost i od lidí, kteří odmítnou. **Meta Pixel se nenačte
 * vůbec, dokud není souhlas s kategorií „Reklama“** — je to nástroj třetí
 * strany a tam je souhlas nesporný.
 *
 * Rozhodnutí se ukládá do localStorage, ne do cookie: nepotřebujeme ho posílat
 * na server a technické úložiště bez souhlasu použít smíme.
 *
 * DŮLEŽITÉ — „Odmítnout vše“ má stejnou velikost, stejný řez i stejné místo
 * jako „Přijmout vše“. Ne odkaz drobným písmem vedle velkého barevného
 * tlačítka; nerovnocenné odmítnutí je samostatná vada (SLOP-H-A8) a v dozoru
 * nejčastější důvod pokuty.
 *
 * Text je záměrně jedna věta. Co se měří, říkají **názvy kategorií**
 * v nastavení — odstavec v liště nikdo nečte a souhlas informovanějším nedělá.
 *
 * Stav a logika žijí v `window.__aiseoConsent` — nastavuje ho BaseLayout
 * v <head> JEŠTĚ PŘED načtením gtag.js, protože `consent default` musí
 * doběhnout dřív než samotné měření. Tahle komponenta je jen jeho UI.
 */
import { consent } from "~/i18n/strings";

const kat = consent.categories;
---

<div
  class="cc"
  id="cookie-consent"
  role="dialog"
  aria-labelledby="cc-body"
  aria-label={consent.aria}
  hidden
>
  <div class="cc__inner">
    <p class="cc__body" id="cc-body">
      <span set:html={consent.bodyHtml}></span>{" "}
      <a class="cc__details" href={consent.detailsHref}>{consent.detailsLabel}</a>
    </p>

    <div class="cc__actions">
      <button type="button" class="cc__btn cc__btn--ghost" data-cc-reject>
        {consent.rejectAllLabel}
      </button>
      <button
        type="button"
        class="cc__btn cc__btn--ghost"
        data-cc-settings
        aria-expanded="false"
        aria-controls="cc-panel"
      >
        {consent.settingsLabel}
      </button>
      <button type="button" class="cc__btn cc__btn--accept" data-cc-accept>
        {consent.acceptAllLabel}
      </button>
    </div>
  </div>

  {/* Nastavení se rozbalí až na vyžádání — v klidovém stavu lištu nenafukuje. */}
  <div class="cc__panel" id="cc-panel" hidden>
    <div class="cc__panel-inner">
      <ul class="cc__cats" role="list">
        <li class="cc__cat">
          <div class="cc__cat-text">
            <span class="cc__cat-label">{kat.necessary.label}</span>
            <span class="cc__cat-desc">{kat.necessary.desc}</span>
          </div>
          <span class="cc__fixed">{kat.necessary.note}</span>
        </li>

        <li class="cc__cat">
          <label class="cc__cat-text" for="cc-analytics">
            <span class="cc__cat-label">{kat.analytics.label}</span>
            <span class="cc__cat-desc">{kat.analytics.desc}</span>
          </label>
          <input class="cc__switch" type="checkbox" id="cc-analytics" data-cc-cat="analytics" />
        </li>

        <li class="cc__cat">
          <label class="cc__cat-text" for="cc-ads">
            <span class="cc__cat-label">{kat.ads.label}</span>
            <span class="cc__cat-desc">{kat.ads.desc}</span>
          </label>
          <input class="cc__switch" type="checkbox" id="cc-ads" data-cc-cat="ads" />
        </li>
      </ul>

      <button type="button" class="cc__btn cc__btn--accept cc__save" data-cc-save>
        {consent.saveLabel}
      </button>
    </div>
  </div>
</div>

<script>
  (() => {
    const box = document.getElementById("cookie-consent");
    if (!box) return;
    const api = (window as any).__aiseoConsent;
    if (!api) return;

    const panel = box.querySelector<HTMLElement>("#cc-panel");
    const tlacitkoNastaveni = box.querySelector<HTMLButtonElement>("[data-cc-settings]");
    const prepinace = Array.from(
      box.querySelectorAll<HTMLInputElement>("[data-cc-cat]"),
    );

    const zobraz = () => {
      // Přepínače vždy odrážejí poslední uložený stav, ne stav z minula.
      const ulozeno = api.get();
      prepinace.forEach((p) => {
        p.checked = !!(ulozeno && ulozeno[p.dataset.ccCat!] === true);
      });
      box.hidden = false;
      box.classList.add("is-open");
    };
    const skryj = () => {
      box.classList.remove("is-open");
      box.hidden = true;
      if (panel) panel.hidden = true;
      tlacitkoNastaveni?.setAttribute("aria-expanded", "false");
    };

    tlacitkoNastaveni?.addEventListener("click", () => {
      if (!panel) return;
      const otevreno = !panel.hidden;
      panel.hidden = otevreno;
      tlacitkoNastaveni.setAttribute("aria-expanded", String(!otevreno));
      if (!otevreno) prepinace[0]?.focus();
    });

    box.querySelector("[data-cc-accept]")?.addEventListener("click", () => {
      api.set({ analytics: true, ads: true });
      skryj();
    });
    box.querySelector("[data-cc-reject]")?.addEventListener("click", () => {
      api.set({ analytics: false, ads: false });
      skryj();
    });
    box.querySelector("[data-cc-save]")?.addEventListener("click", () => {
      const volba: Record<string, boolean> = {};
      prepinace.forEach((p) => {
        volba[p.dataset.ccCat!] = p.checked;
      });
      api.set(volba);
      skryj();
    });

    // Escape lištu jen schová. Zavřít ji bez volby NEZNAMENÁ souhlas ani
    // odmítnutí — nic se neuloží a při dalším načtení se zeptáme znovu.
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !box.hidden) skryj();
    });

    // Odkaz v patičce vrací rozhodnutí zpět na stůl (GDPR čl. 7 odst. 3:
    // odvolat souhlas musí jít stejně snadno jako ho dát).
    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t && t.closest && t.closest("[data-cc-open]")) {
        e.preventDefault();
        zobraz();
        box.querySelector<HTMLButtonElement>("[data-cc-reject]")?.focus();
      }
    });

    if (api.shouldAsk()) zobraz();
  })();
</script>

<style>
  .cc {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 80;
    background: var(--color-paper);
    border-top: 1px solid var(--color-rule-strong);
    box-shadow: 0 -8px 32px -16px oklch(0.2 0.02 260 / 0.35);
    max-height: 85vh;
    overflow-y: auto;
  }
  .cc.is-open {
    animation: ccUp 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @keyframes ccUp {
    from {
      transform: translateY(100%);
    }
    to {
      transform: none;
    }
  }

  .cc__inner {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: 0.9rem var(--space-section-x) 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.75rem;
  }

  .cc__body {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.925rem;
    line-height: 1.5;
    color: var(--color-ink);
  }
  /* Odkaz jde z komponenty, ne ze set:html, ale držíme se pravidla webu:
     potomek vloženého HTML by scoped selektor minul (CLAUDE.md § VI). */
  .cc__body :global(span) {
    color: inherit;
  }

  .cc__details {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--color-ink-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .cc__details:hover {
    color: var(--color-ink);
  }
  .cc__details:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 3px;
  }

  .cc__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  /* Všechna tři tlačítka mají ZÁMĚRNĚ shodnou geometrii i řez. „Odmítnout vše“
     není menší ani bledší než „Přijmout vše“ — to je podmínka platnosti. */
  .cc__btn {
    flex: 0 0 auto;
    min-height: 44px;
    padding: 0.55rem 1.2rem;
    font-family: var(--font-sans);
    font-size: 0.925rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    border-radius: 999px;
    border: 1.5px solid transparent;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .cc__btn--ghost {
    background: var(--color-paper);
    border-color: var(--color-rule-strong);
    color: var(--color-ink);
  }
  .cc__btn--ghost:hover {
    background: var(--color-paper-hover);
    border-color: var(--color-ink-muted);
  }
  .cc__btn--accept {
    background: var(--color-accent-strong);
    color: var(--color-paper);
  }
  .cc__btn--accept:hover {
    background: var(--color-ink);
  }
  .cc__btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* ===== Nastavení po kategoriích ===== */
  .cc__panel {
    border-top: 1px solid var(--color-rule);
    background: var(--color-paper-deep);
  }
  .cc__panel-inner {
    max-width: var(--max-section);
    margin: 0 auto;
    padding: 1rem var(--space-section-x) 1.25rem;
  }

  .cc__cats {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .cc__cat {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .cc__cat:last-child {
    border-bottom: 0;
  }
  .cc__cat-text {
    display: block;
    min-width: 0;
  }
  label.cc__cat-text {
    cursor: pointer;
  }
  .cc__cat-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .cc__cat-desc {
    display: block;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-ink-muted);
  }
  .cc__fixed {
    flex: none;
    font-size: 0.8rem;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }

  /* Nativní checkbox se zvětšeným zásahem — vlastní přepínač by musel znovu
     vyřešit klávesnici, čtečku i vynucené barvy. Nemá to čím vylepšit. */
  .cc__switch {
    flex: none;
    width: 24px;
    height: 24px;
    accent-color: var(--color-accent-strong);
    cursor: pointer;
  }
  .cc__switch:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (max-width: 560px) {
    .cc__inner {
      justify-content: stretch;
    }
    .cc__actions {
      width: 100%;
    }
    /* `1 1 100%` (ne `auto`): na úzkém displeji se tlačítka řadí pod sebe
       a mají SHODNOU šířku. S `auto` se dvě vešly vedle sebe a na „Přijmout
       vše“ zbyl celý řádek — vypadalo to jako hlavní volba a odmítnutí jako
       vedlejší, tedy přesně ten nudge, kvůli kterému lišty padají. */
    .cc__btn {
      flex: 1 1 100%;
    }
    .cc__save {
      width: 100%;
    }
  }
</style>
